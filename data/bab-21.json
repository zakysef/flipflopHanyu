[{"h": "每", "p": "měi", "a": "setiap", "ch": "我每天七点起床。", "cp": "Wǒ měi tiān qī diǎn qǐ chuáng.", "ca": "Saya setiap hari bangun jam tujuh."}, {"h": "早上", "p": "zǎoshang", "a": "pagi", "ch": "早上我去操场锻炼。", "cp": "Zǎoshang wǒ qù cāochǎng duànliàn.", "ca": "Pagi hari saya berolahraga di lapangan."}, {"h": "半", "p": "bàn", "a": "setengah", "ch": "现在七点半。", "cp": "Xiànzài qī diǎn bàn.", "ca": "Sekarang jam setengah delapan (7.30)."}, {"h": "起床", "p": "qǐ chuáng", "a": "bangun tidur", "ch": "你每天几点起床？", "cp": "Nǐ měi tiān jǐ diǎn qǐ chuáng?", "ca": "Setiap hari kamu bangun jam berapa?"}, {"h": "床", "p": "chuáng", "a": "tempat tidur / ranjang", "ch": "这是我的床。", "cp": "Zhè shì wǒ de chuáng.", "ca": "Ini tempat tidur saya."}, {"h": "早饭", "p": "zǎofàn", "a": "sarapan", "ch": "我七点半吃早饭。", "cp": "Wǒ qī diǎn bàn chī zǎofàn.", "ca": "Saya sarapan jam setengah delapan."}, {"h": "午饭", "p": "wǔfàn", "a": "makan siang", "ch": "不回来，要带午饭。", "cp": "Bù huílai, yào dài wǔfàn.", "ca": "Tidak kembali, harus bawa makan siang."}, {"h": "晚饭", "p": "wǎnfàn", "a": "makan malam", "ch": "我们在食堂吃晚饭。", "cp": "Wǒmen zài shítáng chī wǎnfàn.", "ca": "Kami makan malam di kantin."}, {"h": "以后", "p": "yǐhòu", "a": "setelah / kemudian", "ch": "吃早饭以后，我去上课。", "cp": "Chī zǎofàn yǐhòu, wǒ qù shàng kè.", "ca": "Setelah sarapan, saya masuk kelas."}, {"h": "差", "p": "chà", "a": "kurang", "ch": "差五分八点。", "cp": "Chà wǔ fēn bā diǎn.", "ca": "Jam delapan kurang lima menit."}, {"h": "分(钟)", "p": "fēn(zhōng)", "a": "menit", "ch": "现在八点十分。", "cp": "Xiànzài bā diǎn shí fēn.", "ca": "Sekarang jam delapan lewat sepuluh menit."}, {"h": "上课", "p": "shàng kè", "a": "masuk kelas / mulai pelajaran", "ch": "我们八点上课。", "cp": "Wǒmen bā diǎn shàng kè.", "ca": "Kami masuk kelas jam delapan."}, {"h": "节", "p": "jié", "a": "(penggolong jam pelajaran)", "ch": "上午我们有四节课。", "cp": "Shàngwǔ wǒmen yǒu sì jié kè.", "ca": "Pagi ini kami ada empat jam pelajaran."}, {"h": "教室", "p": "jiàoshì", "a": "ruang kelas", "ch": "我们的教室在三楼。", "cp": "Wǒmen de jiàoshì zài sān lóu.", "ca": "Ruang kelas kami di lantai tiga."}, {"h": "操场", "p": "cāochǎng", "a": "lapangan olahraga", "ch": "下午我去操场锻炼。", "cp": "Xiàwǔ wǒ qù cāochǎng duànliàn.", "ca": "Sore hari saya berolahraga di lapangan."}, {"h": "锻炼", "p": "duànliàn", "a": "berolahraga / berlatih fisik", "ch": "我每天锻炼身体。", "cp": "Wǒ měi tiān duànliàn shēntǐ.", "ca": "Saya berolahraga setiap hari."}, {"h": "洗澡", "p": "xǐ zǎo", "a": "mandi", "ch": "我晚上洗澡。", "cp": "Wǒ wǎnshang xǐ zǎo.", "ca": "Saya mandi malam hari."}, {"h": "洗", "p": "xǐ", "a": "mencuci", "ch": "我洗衣服。", "cp": "Wǒ xǐ yīfu.", "ca": "Saya mencuci baju."}, {"h": "然后", "p": "ránhòu", "a": "kemudian / lalu", "ch": "我先复习，然后预习。", "cp": "Wǒ xiān fùxí, ránhòu yùxí.", "ca": "Saya mengulang pelajaran dulu, lalu mempersiapkan pelajaran baru."}, {"h": "睡觉", "p": "shuì jiào", "a": "tidur", "ch": "我十一点睡觉。", "cp": "Wǒ shíyī diǎn shuì jiào.", "ca": "Saya tidur jam sebelas."}, {"h": "爬", "p": "pá", "a": "mendaki / memanjat; merangkak", "ch": "明天我们去爬山。", "cp": "Míngtiān wǒmen qù pá shān.", "ca": "Besok kami pergi mendaki gunung."}, {"h": "们", "p": "men", "a": "(akhiran jamak untuk orang)", "ch": "同学们好！", "cp": "Tóngxuémen hǎo!", "ca": "Halo teman-teman!"}, {"h": "山", "p": "shān", "a": "gunung / bukit", "ch": "那座山不太远。", "cp": "Nà zuò shān bú tài yuǎn.", "ca": "Gunung itu tidak terlalu jauh."}, {"h": "年级", "p": "niánjí", "a": "tingkat (kelas)", "ch": "你是几年级的学生？", "cp": "Nǐ shì jǐ niánjí de xuésheng?", "ca": "Kamu pelajar tingkat berapa?"}, {"h": "出发", "p": "chūfā", "a": "berangkat", "ch": "我们明天七点一刻出发。", "cp": "Wǒmen míngtiān qī diǎn yí kè chūfā.", "ca": "Kami berangkat besok jam 7.15."}, {"h": "前", "p": "qián", "a": "depan", "ch": "在楼前集合。", "cp": "Zài lóu qián jíhé.", "ca": "Berkumpul di depan gedung."}, {"h": "集合", "p": "jíhé", "a": "berkumpul", "ch": "七点在学校门前集合。", "cp": "Qī diǎn zài xuéxiào mén qián jíhé.", "ca": "Jam tujuh berkumpul di depan gerbang sekolah."}, {"h": "刻", "p": "kè", "a": "seperempat jam (15 menit)", "ch": "现在八点一刻。", "cp": "Xiànzài bā diǎn yí kè.", "ca": "Sekarang jam 8.15."}, {"h": "上车", "p": "shàng chē", "a": "naik kendaraan", "ch": "七点一刻上车。", "cp": "Qī diǎn yí kè shàng chē.", "ca": "Naik kendaraan jam 7.15."}, {"h": "下车", "p": "xià chē", "a": "turun dari kendaraan", "ch": "我们在这儿下车。", "cp": "Wǒmen zài zhèr xià chē.", "ca": "Kita turun di sini."}, {"h": "准时", "p": "zhǔnshí", "a": "tepat waktu", "ch": "请准时出发。", "cp": "Qǐng zhǔnshí chūfā.", "ca": "Harap berangkat tepat waktu."}, {"h": "带", "p": "dài", "a": "membawa", "ch": "要带午饭吗？", "cp": "Yào dài wǔfàn ma?", "ca": "Perlu bawa makan siang?"}]