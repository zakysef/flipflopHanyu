[{"h": "秘书", "p": "mìshū", "a": "sekretaris", "ch": "她是经理秘书。", "cp": "Tā shì jīnglǐ mìshū.", "ca": "Dia sekretaris manajer."}, {"h": "先", "p": "xiān", "a": "lebih dulu", "ch": "我先介绍一下儿。", "cp": "Wǒ xiān jièshào yíxiàr.", "ca": "Saya perkenalkan dulu."}, {"h": "介绍", "p": "jièshào", "a": "memperkenalkan", "ch": "我介绍一下儿。", "cp": "Wǒ jièshào yíxiàr.", "ca": "Saya perkenalkan sebentar."}, {"h": "一下儿", "p": "yíxiàr", "a": "sebentar / coba (sekali)", "ch": "请等一下儿。", "cp": "Qǐng děng yíxiàr.", "ca": "Tolong tunggu sebentar."}, {"h": "位", "p": "wèi", "a": "(penggolong sopan untuk orang)", "ch": "这位是王教授。", "cp": "Zhè wèi shì Wáng jiàoshòu.", "ca": "Ini Profesor Wang."}, {"h": "教授", "p": "jiàoshòu", "a": "profesor", "ch": "他是大学教授。", "cp": "Tā shì dàxué jiàoshòu.", "ca": "Dia profesor universitas."}, {"h": "校长", "p": "xiàozhǎng", "a": "kepala sekolah / rektor", "ch": "校长来了。", "cp": "Xiàozhǎng lái le.", "ca": "Rektor sudah datang."}, {"h": "欢迎", "p": "huānyíng", "a": "menyambut / selamat datang", "ch": "欢迎你！", "cp": "Huānyíng nǐ!", "ca": "Selamat datang!"}, {"h": "留学生", "p": "liúxuéshēng", "a": "mahasiswa asing", "ch": "他是留学生。", "cp": "Tā shì liúxuéshēng.", "ca": "Dia mahasiswa asing."}, {"h": "留学", "p": "liúxué", "a": "belajar di luar negeri", "ch": "我在中国留学。", "cp": "Wǒ zài Zhōngguó liúxué.", "ca": "Saya kuliah di China."}, {"h": "也", "p": "yě", "a": "juga", "ch": "我也去。", "cp": "Wǒ yě qù.", "ca": "Saya juga pergi."}, {"h": "我们", "p": "wǒmen", "a": "kami / kita", "ch": "我们是朋友。", "cp": "Wǒmen shì péngyou.", "ca": "Kami adalah teman."}, {"h": "你们", "p": "nǐmen", "a": "kalian", "ch": "你们好！", "cp": "Nǐmen hǎo!", "ca": "Halo semuanya!"}, {"h": "他们", "p": "tāmen", "a": "mereka", "ch": "他们都是学生。", "cp": "Tāmen dōu shì xuésheng.", "ca": "Mereka semua pelajar."}, {"h": "都", "p": "dōu", "a": "semua / sama-sama", "ch": "我们都是留学生。", "cp": "Wǒmen dōu shì liúxuéshēng.", "ca": "Kami semua mahasiswa asing."}, {"h": "和", "p": "hé", "a": "dan", "ch": "我和他都是留学生。", "cp": "Wǒ hé tā dōu shì liúxuéshēng.", "ca": "Saya dan dia sama-sama mahasiswa asing."}, {"h": "俩", "p": "liǎ", "a": "dua (orang); berdua", "ch": "我们俩是朋友。", "cp": "Wǒmen liǎ shì péngyou.", "ca": "Kami berdua adalah teman."}, {"h": "学生", "p": "xuésheng", "a": "pelajar / murid", "ch": "我是学生。", "cp": "Wǒ shì xuésheng.", "ca": "Saya pelajar."}, {"h": "没什么", "p": "méi shénme", "a": "tidak apa-apa", "ch": "没什么，别客气。", "cp": "Méi shénme, bié kèqi.", "ca": "Tidak apa-apa, jangan sungkan."}]