[{"h": "东边", "p": "dōngbian", "a": "sebelah timur", "ch": "图书馆在学校东边。", "cp": "Túshūguǎn zài xuéxiào dōngbian.", "ca": "Perpustakaan ada di sebelah timur sekolah."}, {"h": "西边", "p": "xībian", "a": "sebelah barat", "ch": "食堂西边是宿舍。", "cp": "Shítáng xībian shì sùshè.", "ca": "Di sebelah barat kantin adalah asrama."}, {"h": "南边", "p": "nánbian", "a": "sebelah selatan", "ch": "银行在邮局南边。", "cp": "Yínháng zài yóujú nánbian.", "ca": "Bank ada di sebelah selatan kantor pos."}, {"h": "北边", "p": "běibian", "a": "sebelah utara", "ch": "公园在学校北边。", "cp": "Gōngyuán zài xuéxiào běibian.", "ca": "Taman ada di sebelah utara sekolah."}, {"h": "前边", "p": "qiánbian", "a": "di depan", "ch": "前边有一个超市。", "cp": "Qiánbian yǒu yí gè chāoshì.", "ca": "Di depan ada sebuah supermarket."}, {"h": "后边", "p": "hòubian", "a": "di belakang", "ch": "宿舍后边是操场。", "cp": "Sùshè hòubian shì cāochǎng.", "ca": "Di belakang asrama adalah lapangan."}, {"h": "左边", "p": "zuǒbian", "a": "sebelah kiri", "ch": "邮局在银行左边。", "cp": "Yóujú zài yínháng zuǒbian.", "ca": "Kantor pos ada di sebelah kiri bank."}, {"h": "右边", "p": "yòubian", "a": "sebelah kanan", "ch": "书店在超市右边。", "cp": "Shūdiàn zài chāoshì yòubian.", "ca": "Toko buku ada di sebelah kanan supermarket."}, {"h": "里边", "p": "lǐbian", "a": "di dalam", "ch": "学校里边有邮局吗？", "cp": "Xuéxiào lǐbian yǒu yóujú ma?", "ca": "Apakah di dalam sekolah ada kantor pos?"}, {"h": "外边", "p": "wàibian", "a": "di luar", "ch": "外边有很多人。", "cp": "Wàibian yǒu hěn duō rén.", "ca": "Di luar ada banyak orang."}, {"h": "上边", "p": "shàngbian", "a": "di atas", "ch": "书在箱子上边。", "cp": "Shū zài xiāngzi shàngbian.", "ca": "Bukunya ada di atas koper."}, {"h": "下边", "p": "xiàbian", "a": "di bawah", "ch": "箱子在床下边。", "cp": "Xiāngzi zài chuáng xiàbian.", "ca": "Kopernya ada di bawah tempat tidur."}, {"h": "离", "p": "lí", "a": "dari (jarak)", "ch": "博物馆离这儿远吗？", "cp": "Bówùguǎn lí zhèr yuǎn ma?", "ca": "Apakah museum jauh dari sini?"}, {"h": "远", "p": "yuǎn", "a": "jauh", "ch": "我家离学校很远。", "cp": "Wǒ jiā lí xuéxiào hěn yuǎn.", "ca": "Rumah saya jauh dari sekolah."}, {"h": "近", "p": "jìn", "a": "dekat", "ch": "邮局离这儿很近。", "cp": "Yóujú lí zhèr hěn jìn.", "ca": "Kantor pos dekat dari sini."}, {"h": "地方", "p": "dìfang", "a": "tempat", "ch": "这是什么地方？", "cp": "Zhè shì shénme dìfang?", "ca": "Ini tempat apa?"}, {"h": "足球场", "p": "zúqiúchǎng", "a": "lapangan sepak bola", "ch": "足球场在宿舍北边。", "cp": "Zúqiúchǎng zài sùshè běibian.", "ca": "Lapangan sepak bola ada di sebelah utara asrama."}, {"h": "足球", "p": "zúqiú", "a": "sepak bola", "ch": "我喜欢看足球。", "cp": "Wǒ xǐhuan kàn zúqiú.", "ca": "Saya suka menonton sepak bola."}, {"h": "劳驾", "p": "láo jià", "a": "permisi / maaf merepotkan", "ch": "劳驾，博物馆在哪儿？", "cp": "Láo jià, bówùguǎn zài nǎr?", "ca": "Permisi, museum ada di mana?"}, {"h": "打听", "p": "dǎting", "a": "menanyakan (informasi)", "ch": "我打听一下儿，邮局在哪儿？", "cp": "Wǒ dǎting yíxiàr, yóujú zài nǎr?", "ca": "Saya mau tanya, kantor pos di mana?"}, {"h": "博物馆", "p": "bówùguǎn", "a": "museum", "ch": "从这儿到博物馆有多远？", "cp": "Cóng zhèr dào bówùguǎn yǒu duō yuǎn?", "ca": "Dari sini ke museum seberapa jauh?"}, {"h": "和平", "p": "hépíng", "a": "perdamaian / damai", "ch": "我们都喜欢和平。", "cp": "Wǒmen dōu xǐhuan hépíng.", "ca": "Kita semua menyukai perdamaian."}, {"h": "广场", "p": "guǎngchǎng", "a": "alun-alun / lapangan kota", "ch": "博物馆在和平广场东边。", "cp": "Bówùguǎn zài Hépíng Guǎngchǎng dōngbian.", "ca": "Museum ada di sebelah timur Alun-alun Heping."}, {"h": "中间", "p": "zhōngjiān", "a": "di tengah / di antara", "ch": "银行在邮局和书店中间。", "cp": "Yínháng zài yóujú hé shūdiàn zhōngjiān.", "ca": "Bank ada di antara kantor pos dan toko buku."}, {"h": "从", "p": "cóng", "a": "dari (waktu / tempat)", "ch": "从这儿往前走。", "cp": "Cóng zhèr wǎng qián zǒu.", "ca": "Dari sini jalan lurus ke depan."}, {"h": "到", "p": "dào", "a": "sampai / tiba", "ch": "从学校到银行不太远。", "cp": "Cóng xuéxiào dào yínháng bú tài yuǎn.", "ca": "Dari sekolah ke bank tidak terlalu jauh."}, {"h": "米", "p": "mǐ", "a": "meter", "ch": "大概有七八百米。", "cp": "Dàgài yǒu qī-bābǎi mǐ.", "ca": "Kira-kira tujuh atau delapan ratus meter."}, {"h": "一直", "p": "yìzhí", "a": "terus / lurus", "ch": "一直往前走。", "cp": "Yìzhí wǎng qián zǒu.", "ca": "Jalan lurus terus ke depan."}, {"h": "红绿灯", "p": "hónglǜdēng", "a": "lampu lalu lintas", "ch": "到红绿灯往右拐。", "cp": "Dào hónglǜdēng wǎng yòu guǎi.", "ca": "Sampai lampu merah belok kanan."}, {"h": "绿", "p": "lǜ", "a": "hijau", "ch": "我喜欢绿颜色。", "cp": "Wǒ xǐhuan lǜ yánsè.", "ca": "Saya suka warna hijau."}, {"h": "灯", "p": "dēng", "a": "lampu", "ch": "请开灯。", "cp": "Qǐng kāi dēng.", "ca": "Tolong nyalakan lampu."}, {"h": "往", "p": "wǎng", "a": "ke arah / menuju", "ch": "往前走。", "cp": "Wǎng qián zǒu.", "ca": "Jalan ke depan."}, {"h": "左", "p": "zuǒ", "a": "kiri", "ch": "到红绿灯往左拐。", "cp": "Dào hónglǜdēng wǎng zuǒ guǎi.", "ca": "Sampai lampu merah belok kiri."}, {"h": "右", "p": "yòu", "a": "kanan", "ch": "往右拐就是银行。", "cp": "Wǎng yòu guǎi jiù shì yínháng.", "ca": "Belok kanan, itulah banknya."}, {"h": "拐", "p": "guǎi", "a": "berbelok", "ch": "在前边往左拐。", "cp": "Zài qiánbian wǎng zuǒ guǎi.", "ca": "Di depan belok kiri."}, {"h": "马路", "p": "mǎlù", "a": "jalan raya", "ch": "马路上车很多。", "cp": "Mǎlù shang chē hěn duō.", "ca": "Di jalan raya banyak kendaraan."}, {"h": "路", "p": "lù", "a": "jalan", "ch": "路很远吗？", "cp": "Lù hěn yuǎn ma?", "ca": "Apakah jalannya jauh?"}, {"h": "座", "p": "zuò", "a": "(penggolong gedung / gunung)", "ch": "那座白色的楼就是博物馆。", "cp": "Nà zuò báisè de lóu jiù shì bówùguǎn.", "ca": "Gedung putih itulah museumnya."}, {"h": "白色", "p": "báisè", "a": "warna putih", "ch": "我的自行车是白色的。", "cp": "Wǒ de zìxíngchē shì báisè de.", "ca": "Sepeda saya berwarna putih."}]