[{"h": "现在", "p": "xiànzài", "a": "sekarang", "ch": "你现在去哪儿？", "cp": "Nǐ xiànzài qù nǎr?", "ca": "Sekarang kamu mau ke mana?"}, {"h": "跟", "p": "gēn", "a": "dengan / bersama; mengikuti", "ch": "你跟我一起去，好吗？", "cp": "Nǐ gēn wǒ yìqǐ qù, hǎo ma?", "ca": "Kamu pergi bersama saya, ya?"}, {"h": "一起", "p": "yìqǐ", "a": "bersama-sama", "ch": "我们一起去吃饭吧。", "cp": "Wǒmen yìqǐ qù chī fàn ba.", "ca": "Ayo kita pergi makan bersama."}, {"h": "咱们", "p": "zánmen", "a": "kita (termasuk lawan bicara)", "ch": "咱们走吧。", "cp": "Zánmen zǒu ba.", "ca": "Ayo kita pergi."}, {"h": "走", "p": "zǒu", "a": "berjalan / pergi", "ch": "我走了，再见！", "cp": "Wǒ zǒu le, zàijiàn!", "ca": "Saya pergi dulu, sampai jumpa!"}, {"h": "常(常)", "p": "cháng(cháng)", "a": "sering", "ch": "你常去图书馆吗？", "cp": "Nǐ cháng qù túshūguǎn ma?", "ca": "Apakah kamu sering ke perpustakaan?"}, {"h": "有时候", "p": "yǒu shíhou", "a": "kadang-kadang", "ch": "我有时候去图书馆。", "cp": "Wǒ yǒu shíhou qù túshūguǎn.", "ca": "Saya kadang-kadang pergi ke perpustakaan."}, {"h": "时候", "p": "shíhou", "a": "waktu / saat", "ch": "你什么时候去？", "cp": "Nǐ shénme shíhou qù?", "ca": "Kapan kamu pergi?"}, {"h": "借", "p": "jiè", "a": "meminjam / meminjamkan", "ch": "我去图书馆借书。", "cp": "Wǒ qù túshūguǎn jiè shū.", "ca": "Saya ke perpustakaan meminjam buku."}, {"h": "上网", "p": "shàng wǎng", "a": "menggunakan internet (online)", "ch": "我常常上网。", "cp": "Wǒ chángcháng shàng wǎng.", "ca": "Saya sering online."}, {"h": "网", "p": "wǎng", "a": "jaringan / internet", "ch": "网上有很多资料。", "cp": "Wǎng shang yǒu hěn duō zīliào.", "ca": "Di internet ada banyak bahan."}, {"h": "查", "p": "chá", "a": "memeriksa / mencari (informasi)", "ch": "我上网查资料。", "cp": "Wǒ shàng wǎng chá zīliào.", "ca": "Saya mencari bahan di internet."}, {"h": "资料", "p": "zīliào", "a": "bahan / data", "ch": "我去图书馆查资料。", "cp": "Wǒ qù túshūguǎn chá zīliào.", "ca": "Saya ke perpustakaan mencari bahan."}, {"h": "总(是)", "p": "zǒng(shì)", "a": "selalu", "ch": "他总是很忙。", "cp": "Tā zǒngshì hěn máng.", "ca": "Dia selalu sibuk."}, {"h": "安静", "p": "ānjìng", "a": "tenang / sepi", "ch": "图书馆很安静。", "cp": "Túshūguǎn hěn ānjìng.", "ca": "Perpustakaan sangat tenang."}, {"h": "晚上", "p": "wǎnshang", "a": "malam", "ch": "晚上你常做什么？", "cp": "Wǎnshang nǐ cháng zuò shénme?", "ca": "Malam hari kamu biasanya melakukan apa?"}, {"h": "复习", "p": "fùxí", "a": "mengulang pelajaran", "ch": "晚上我复习课文。", "cp": "Wǎnshang wǒ fùxí kèwén.", "ca": "Malam hari saya mengulang teks pelajaran."}, {"h": "课文", "p": "kèwén", "a": "teks pelajaran", "ch": "我读课文。", "cp": "Wǒ dú kèwén.", "ca": "Saya membaca teks pelajaran."}, {"h": "预习", "p": "yùxí", "a": "mempelajari lebih dulu (persiapan pelajaran)", "ch": "我预习生词。", "cp": "Wǒ yùxí shēngcí.", "ca": "Saya mempelajari kosakata baru lebih dulu."}, {"h": "生词", "p": "shēngcí", "a": "kosakata baru", "ch": "这课的生词很多。", "cp": "Zhè kè de shēngcí hěn duō.", "ca": "Kosakata baru pelajaran ini banyak."}, {"h": "或者", "p": "huòzhě", "a": "atau (dalam pernyataan)", "ch": "我去公园或者去超市。", "cp": "Wǒ qù gōngyuán huòzhě qù chāoshì.", "ca": "Saya ke taman atau ke supermarket."}, {"h": "练习", "p": "liànxí", "a": "berlatih / latihan", "ch": "我练习写汉字。", "cp": "Wǒ liànxí xiě Hànzì.", "ca": "Saya berlatih menulis aksara Han."}, {"h": "聊天儿", "p": "liáo tiānr", "a": "mengobrol", "ch": "我跟朋友聊天儿。", "cp": "Wǒ gēn péngyou liáo tiānr.", "ca": "Saya mengobrol dengan teman."}, {"h": "收发", "p": "shōufā", "a": "menerima dan mengirim", "ch": "我上网收发伊妹儿。", "cp": "Wǒ shàng wǎng shōufā yīmèir.", "ca": "Saya online untuk menerima dan mengirim e-mail."}, {"h": "收", "p": "shōu", "a": "menerima", "ch": "我常常收朋友的信。", "cp": "Wǒ chángcháng shōu péngyou de xìn.", "ca": "Saya sering menerima surat dari teman."}, {"h": "发", "p": "fā", "a": "mengirim", "ch": "我给妈妈发伊妹儿。", "cp": "Wǒ gěi māma fā yīmèir.", "ca": "Saya mengirim e-mail kepada ibu."}, {"h": "伊妹儿", "p": "yīmèir", "a": "e-mail", "ch": "这是我的伊妹儿。", "cp": "Zhè shì wǒ de yīmèir.", "ca": "Ini e-mail saya."}, {"h": "电影", "p": "diànyǐng", "a": "film", "ch": "晚上咱们去看电影，好吗？", "cp": "Wǎnshang zánmen qù kàn diànyǐng, hǎo ma?", "ca": "Malam ini kita nonton film, yuk?"}, {"h": "电视剧", "p": "diànshìjù", "a": "drama TV / sinetron", "ch": "我妈妈常看电视剧。", "cp": "Wǒ māma cháng kàn diànshìjù.", "ca": "Ibu saya sering menonton drama TV."}, {"h": "电视", "p": "diànshì", "a": "televisi", "ch": "晚上我看电视。", "cp": "Wǎnshang wǒ kàn diànshì.", "ca": "Malam hari saya menonton TV."}, {"h": "休息", "p": "xiūxi", "a": "beristirahat", "ch": "我在宿舍休息。", "cp": "Wǒ zài sùshè xiūxi.", "ca": "Saya beristirahat di asrama."}, {"h": "宿舍", "p": "sùshè", "a": "asrama", "ch": "我住在留学生宿舍。", "cp": "Wǒ zhù zài liúxuéshēng sùshè.", "ca": "Saya tinggal di asrama mahasiswa asing."}, {"h": "公园", "p": "gōngyuán", "a": "taman", "ch": "星期天我去公园玩儿。", "cp": "Xīngqītiān wǒ qù gōngyuán wánr.", "ca": "Hari Minggu saya bermain ke taman."}, {"h": "超市", "p": "chāoshì", "a": "supermarket", "ch": "我去超市买东西。", "cp": "Wǒ qù chāoshì mǎi dōngxi.", "ca": "Saya ke supermarket berbelanja."}, {"h": "东西", "p": "dōngxi", "a": "barang / benda", "ch": "你买什么东西？", "cp": "Nǐ mǎi shénme dōngxi?", "ca": "Kamu beli barang apa?"}]