[{"h": "学", "p": "xué", "a": "belajar", "ch": "我学汉语。", "cp": "Wǒ xué Hànyǔ.", "ca": "Saya belajar Mandarin."}, {"h": "英语", "p": "Yīngyǔ", "a": "bahasa Inggris", "ch": "他学英语。", "cp": "Tā xué Yīngyǔ.", "ca": "Dia belajar bahasa Inggris."}, {"h": "阿拉伯语", "p": "Ālābóyǔ", "a": "bahasa Arab", "ch": "他学阿拉伯语。", "cp": "Tā xué Ālābóyǔ.", "ca": "Dia belajar bahasa Arab."}, {"h": "德语", "p": "Déyǔ", "a": "bahasa Jerman", "ch": "我学德语。", "cp": "Wǒ xué Déyǔ.", "ca": "Saya belajar bahasa Jerman."}, {"h": "俄语", "p": "Éyǔ", "a": "bahasa Rusia", "ch": "俄语很难。", "cp": "Éyǔ hěn nán.", "ca": "Bahasa Rusia sulit."}, {"h": "法语", "p": "Fǎyǔ", "a": "bahasa Prancis", "ch": "法语难吗？", "cp": "Fǎyǔ nán ma?", "ca": "Apakah bahasa Prancis sulit?"}, {"h": "韩国语", "p": "Hánguóyǔ", "a": "bahasa Korea", "ch": "她学韩国语。", "cp": "Tā xué Hánguóyǔ.", "ca": "Dia belajar bahasa Korea."}, {"h": "日语", "p": "Rìyǔ", "a": "bahasa Jepang", "ch": "日语不太难。", "cp": "Rìyǔ bú tài nán.", "ca": "Bahasa Jepang tidak terlalu sulit."}, {"h": "西班牙语", "p": "Xībānyáyǔ", "a": "bahasa Spanyol", "ch": "我哥哥学西班牙语。", "cp": "Wǒ gēge xué Xībānyáyǔ.", "ca": "Kakak saya belajar bahasa Spanyol."}, {"h": "对", "p": "duì", "a": "benar", "ch": "你说得对。", "cp": "Nǐ shuō de duì.", "ca": "Kamu benar."}, {"h": "明天", "p": "míngtiān", "a": "besok", "ch": "明天见！", "cp": "Míngtiān jiàn!", "ca": "Sampai jumpa besok!"}, {"h": "见", "p": "jiàn", "a": "melihat / bertemu", "ch": "我明天去见老师。", "cp": "Wǒ míngtiān qù jiàn lǎoshī.", "ca": "Besok saya pergi menemui guru."}, {"h": "去", "p": "qù", "a": "pergi", "ch": "我去学校。", "cp": "Wǒ qù xuéxiào.", "ca": "Saya pergi ke sekolah."}, {"h": "邮局", "p": "yóujú", "a": "kantor pos", "ch": "我去邮局寄信。", "cp": "Wǒ qù yóujú jì xìn.", "ca": "Saya pergi ke kantor pos mengirim surat."}, {"h": "寄", "p": "jì", "a": "mengirim (lewat pos)", "ch": "我寄一封信。", "cp": "Wǒ jì yì fēng xìn.", "ca": "Saya mengirim satu surat."}, {"h": "信", "p": "xìn", "a": "surat", "ch": "这是一封信。", "cp": "Zhè shì yì fēng xìn.", "ca": "Ini sebuah surat."}, {"h": "银行", "p": "yínháng", "a": "bank", "ch": "我去银行取钱。", "cp": "Wǒ qù yínháng qǔ qián.", "ca": "Saya ke bank mengambil uang."}, {"h": "取", "p": "qǔ", "a": "mengambil", "ch": "我去取钱。", "cp": "Wǒ qù qǔ qián.", "ca": "Saya pergi mengambil uang."}, {"h": "钱", "p": "qián", "a": "uang", "ch": "我没有钱。", "cp": "Wǒ méiyǒu qián.", "ca": "Saya tidak punya uang."}, {"h": "六", "p": "liù", "a": "enam", "ch": "六点了。", "cp": "Liù diǎn le.", "ca": "Sudah jam enam."}, {"h": "七", "p": "qī", "a": "tujuh", "ch": "七个人。", "cp": "Qī gè rén.", "ca": "Tujuh orang."}, {"h": "九", "p": "jiǔ", "a": "sembilan", "ch": "九个学生。", "cp": "Jiǔ gè xuésheng.", "ca": "Sembilan pelajar."}]