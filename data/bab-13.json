[{"h": "没(有)", "p": "méi(yǒu)", "a": "tidak punya / tidak ada / belum", "ch": "我没有箱子。", "cp": "Wǒ méiyǒu xiāngzi.", "ca": "Saya tidak punya koper."}, {"h": "箱子", "p": "xiāngzi", "a": "koper / kotak", "ch": "这个箱子很重。", "cp": "Zhège xiāngzi hěn zhòng.", "ca": "Koper ini berat."}, {"h": "有", "p": "yǒu", "a": "punya / ada", "ch": "我有一本书。", "cp": "Wǒ yǒu yì běn shū.", "ca": "Saya punya satu buku."}, {"h": "这儿", "p": "zhèr", "a": "di sini", "ch": "请来这儿。", "cp": "Qǐng lái zhèr.", "ca": "Silakan datang ke sini."}, {"h": "重", "p": "zhòng", "a": "berat", "ch": "这个很重。", "cp": "Zhège hěn zhòng.", "ca": "Ini sangat berat."}, {"h": "黑", "p": "hēi", "a": "hitam", "ch": "黑色的箱子。", "cp": "Hēisè de xiāngzi.", "ca": "Koper berwarna hitam."}, {"h": "红", "p": "hóng", "a": "merah", "ch": "红色的衣服。", "cp": "Hóngsè de yīfu.", "ca": "Baju berwarna merah."}, {"h": "轻", "p": "qīng", "a": "ringan", "ch": "这个很轻。", "cp": "Zhège hěn qīng.", "ca": "Ini sangat ringan."}, {"h": "旧", "p": "jiù", "a": "lama / bekas", "ch": "这是旧书。", "cp": "Zhè shì jiù shū.", "ca": "Ini buku lama."}, {"h": "药", "p": "yào", "a": "obat", "ch": "我要买药。", "cp": "Wǒ yào mǎi yào.", "ca": "Saya mau beli obat."}, {"h": "中药", "p": "zhōngyào", "a": "obat tradisional China", "ch": "中药很苦。", "cp": "Zhōngyào hěn kǔ.", "ca": "Obat tradisional China pahit."}, {"h": "西药", "p": "xīyào", "a": "obat Barat", "ch": "这些是西药。", "cp": "Zhèxiē shì xīyào.", "ca": "Ini semua obat Barat."}, {"h": "茶叶", "p": "cháyè", "a": "daun teh", "ch": "这是中国茶叶。", "cp": "Zhè shì Zhōngguó cháyè.", "ca": "Ini daun teh China."}, {"h": "里", "p": "lǐ", "a": "di dalam", "ch": "箱子里有药。", "cp": "Xiāngzi li yǒu yào.", "ca": "Di dalam koper ada obat."}, {"h": "日用品", "p": "rìyòngpǐn", "a": "barang kebutuhan sehari-hari", "ch": "我要买日用品。", "cp": "Wǒ yào mǎi rìyòngpǐn.", "ca": "Saya mau beli kebutuhan sehari-hari."}, {"h": "件", "p": "jiàn", "a": "(penggolong baju / barang)", "ch": "一件衣服。", "cp": "Yí jiàn yīfu.", "ca": "Satu potong baju."}, {"h": "衣服", "p": "yīfu", "a": "pakaian", "ch": "这件衣服很好看。", "cp": "Zhè jiàn yīfu hěn hǎokàn.", "ca": "Baju ini bagus."}, {"h": "把", "p": "bǎ", "a": "(penggolong benda bergagang)", "ch": "一把雨伞。", "cp": "Yì bǎ yǔsǎn.", "ca": "Satu payung."}, {"h": "雨伞", "p": "yǔsǎn", "a": "payung", "ch": "我要买雨伞。", "cp": "Wǒ yào mǎi yǔsǎn.", "ca": "Saya mau beli payung."}, {"h": "雨", "p": "yǔ", "a": "hujan", "ch": "今天下雨了。", "cp": "Jīntiān xià yǔ le.", "ca": "Hari ini hujan."}, {"h": "瓶", "p": "píng", "a": "botol", "ch": "一瓶水。", "cp": "Yì píng shuǐ.", "ca": "Satu botol air."}, {"h": "香水", "p": "xiāngshuǐ", "a": "parfum", "ch": "这瓶香水很香。", "cp": "Zhè píng xiāngshuǐ hěn xiāng.", "ca": "Parfum ini wangi."}, {"h": "水", "p": "shuǐ", "a": "air", "ch": "我要喝水。", "cp": "Wǒ yào hē shuǐ.", "ca": "Saya mau minum air."}, {"h": "本", "p": "běn", "a": "(penggolong buku)", "ch": "一本书。", "cp": "Yì běn shū.", "ca": "Satu buku."}, {"h": "词典", "p": "cídiǎn", "a": "kamus", "ch": "我买一本词典。", "cp": "Wǒ mǎi yì běn cídiǎn.", "ca": "Saya beli satu kamus."}, {"h": "张", "p": "zhāng", "a": "(penggolong benda lembaran)", "ch": "一张光盘。", "cp": "Yì zhāng guāngpán.", "ca": "Satu keping CD."}, {"h": "光盘", "p": "guāngpán", "a": "CD / VCD / DVD", "ch": "这是汉语光盘。", "cp": "Zhè shì Hànyǔ guāngpán.", "ca": "Ini CD bahasa Mandarin."}, {"h": "支", "p": "zhī", "a": "(penggolong pena / pensil)", "ch": "一支笔。", "cp": "Yì zhī bǐ.", "ca": "Satu batang pena."}, {"h": "笔", "p": "bǐ", "a": "pena / pensil / kuas", "ch": "我用笔写字。", "cp": "Wǒ yòng bǐ xiě zì.", "ca": "Saya menulis dengan pena."}]