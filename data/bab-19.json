[{"h": "羽绒服", "p": "yǔróngfú", "a": "jaket bulu angsa (down jacket)", "ch": "这件羽绒服多少钱？", "cp": "Zhè jiàn yǔróngfú duōshao qián?", "ca": "Jaket bulu angsa ini berapa?"}, {"h": "又…又…", "p": "yòu…yòu…", "a": "…dan juga… (sekaligus)", "ch": "这件衣服又便宜又好看。", "cp": "Zhè jiàn yīfu yòu piányi yòu hǎokàn.", "ca": "Baju ini murah dan juga bagus."}, {"h": "便宜", "p": "piányi", "a": "murah", "ch": "这个很便宜。", "cp": "Zhège hěn piányi.", "ca": "Ini murah sekali."}, {"h": "长", "p": "cháng", "a": "panjang", "ch": "这件衣服太长了。", "cp": "Zhè jiàn yīfu tài cháng le.", "ca": "Baju ini terlalu panjang."}, {"h": "一点儿", "p": "yìdiǎnr", "a": "sedikit (lebih)", "ch": "便宜一点儿吧。", "cp": "Piányi yìdiǎnr ba.", "ca": "Lebih murah sedikit, dong."}, {"h": "短", "p": "duǎn", "a": "pendek", "ch": "这件有点儿短。", "cp": "Zhè jiàn yǒudiǎnr duǎn.", "ca": "Yang ini agak pendek."}, {"h": "深", "p": "shēn", "a": "tua (warna); dalam", "ch": "我要深颜色的。", "cp": "Wǒ yào shēn yánsè de.", "ca": "Saya mau yang warnanya tua."}, {"h": "浅", "p": "qiǎn", "a": "muda (warna); dangkal", "ch": "有浅一点儿的吗？", "cp": "Yǒu qiǎn yìdiǎnr de ma?", "ca": "Ada yang warnanya lebih muda?"}, {"h": "试", "p": "shì", "a": "mencoba", "ch": "我可以试试吗？", "cp": "Wǒ kěyǐ shìshi ma?", "ca": "Boleh saya coba?"}, {"h": "可以", "p": "kěyǐ", "a": "boleh / bisa", "ch": "可以打八折。", "cp": "Kěyǐ dǎ bā zhé.", "ca": "Bisa diskon 20%."}, {"h": "当然", "p": "dāngrán", "a": "tentu saja", "ch": "当然可以。", "cp": "Dāngrán kěyǐ.", "ca": "Tentu saja boleh."}, {"h": "肥", "p": "féi", "a": "longgar (pakaian); gemuk (hewan)", "ch": "这件太肥了。", "cp": "Zhè jiàn tài féi le.", "ca": "Yang ini terlalu longgar."}, {"h": "胖", "p": "pàng", "a": "gemuk (orang)", "ch": "他有点儿胖。", "cp": "Tā yǒudiǎnr pàng.", "ca": "Dia agak gemuk."}, {"h": "瘦", "p": "shòu", "a": "kurus; sempit (pakaian)", "ch": "这件有点儿瘦。", "cp": "Zhè jiàn yǒudiǎnr shòu.", "ca": "Yang ini agak sempit."}, {"h": "合适", "p": "héshì", "a": "pas / cocok", "ch": "这件很合适。", "cp": "Zhè jiàn hěn héshì.", "ca": "Yang ini sangat pas."}, {"h": "好看", "p": "hǎokàn", "a": "bagus dilihat / cantik", "ch": "这个颜色很好看。", "cp": "Zhège yánsè hěn hǎokàn.", "ca": "Warna ini bagus."}, {"h": "种", "p": "zhǒng", "a": "jenis / macam", "ch": "这种颜色怎么样？", "cp": "Zhè zhǒng yánsè zěnmeyàng?", "ca": "Bagaimana warna yang ini?"}, {"h": "打折", "p": "dǎ zhé", "a": "memberi diskon", "ch": "可以打折吗？", "cp": "Kěyǐ dǎ zhé ma?", "ca": "Bisa diskon?"}]