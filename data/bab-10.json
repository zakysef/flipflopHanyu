[{"h": "办公室", "p": "bàngōngshì", "a": "kantor", "ch": "经理在办公室。", "cp": "Jīnglǐ zài bàngōngshì.", "ca": "Manajer ada di kantor."}, {"h": "办公", "p": "bàngōng", "a": "bekerja (di kantor)", "ch": "他在办公。", "cp": "Tā zài bàngōng.", "ca": "Dia sedang bekerja di kantor."}, {"h": "职员", "p": "zhíyuán", "a": "pegawai / staf kantor", "ch": "他是公司职员。", "cp": "Tā shì gōngsī zhíyuán.", "ca": "Dia pegawai perusahaan."}, {"h": "找", "p": "zhǎo", "a": "mencari", "ch": "我找王先生。", "cp": "Wǒ zhǎo Wáng xiānsheng.", "ca": "Saya mencari Tuan Wang."}, {"h": "在", "p": "zài", "a": "berada di / di", "ch": "他在家。", "cp": "Tā zài jiā.", "ca": "Dia di rumah."}, {"h": "家", "p": "jiā", "a": "rumah / keluarga; (penggolong toko, perusahaan)", "ch": "我家在北京。", "cp": "Wǒ jiā zài Běijīng.", "ca": "Rumah saya di Beijing."}, {"h": "呢", "p": "ne", "a": "partikel penegas di akhir kalimat", "ch": "他在家呢。", "cp": "Tā zài jiā ne.", "ca": "Dia ada di rumah kok."}, {"h": "住", "p": "zhù", "a": "tinggal", "ch": "我住在三楼。", "cp": "Wǒ zhù zài sān lóu.", "ca": "Saya tinggal di lantai tiga."}, {"h": "楼", "p": "lóu", "a": "gedung / lantai", "ch": "这是三号楼。", "cp": "Zhè shì sān hào lóu.", "ca": "Ini gedung nomor tiga."}, {"h": "门", "p": "mén", "a": "pintu / gerbang", "ch": "请关门。", "cp": "Qǐng guān mén.", "ca": "Tolong tutup pintunya."}, {"h": "房间", "p": "fángjiān", "a": "kamar", "ch": "我的房间很小。", "cp": "Wǒ de fángjiān hěn xiǎo.", "ca": "Kamar saya kecil."}, {"h": "号", "p": "hào", "a": "nomor", "ch": "他住几号房间？", "cp": "Tā zhù jǐ hào fángjiān?", "ca": "Dia tinggal di kamar nomor berapa?"}, {"h": "知道", "p": "zhīdào", "a": "tahu", "ch": "我不知道。", "cp": "Wǒ bù zhīdào.", "ca": "Saya tidak tahu."}, {"h": "电话", "p": "diànhuà", "a": "telepon", "ch": "请打电话给我。", "cp": "Qǐng dǎ diànhuà gěi wǒ.", "ca": "Tolong telepon saya."}, {"h": "电", "p": "diàn", "a": "listrik", "ch": "没有电了。", "cp": "Méiyǒu diàn le.", "ca": "Listriknya mati."}, {"h": "话", "p": "huà", "a": "kata-kata / ucapan", "ch": "他的话很多。", "cp": "Tā de huà hěn duō.", "ca": "Dia banyak bicara."}, {"h": "号码", "p": "hàomǎ", "a": "nomor", "ch": "你的电话号码是多少？", "cp": "Nǐ de diànhuà hàomǎ shì duōshao?", "ca": "Berapa nomor teleponmu?"}, {"h": "零", "p": "líng", "a": "nol (juga ditulis 〇)", "ch": "一零一。", "cp": "Yāo líng yāo.", "ca": "Satu nol satu (101)."}, {"h": "手机", "p": "shǒujī", "a": "ponsel", "ch": "这是我的手机。", "cp": "Zhè shì wǒ de shǒujī.", "ca": "Ini ponsel saya."}, {"h": "手", "p": "shǒu", "a": "tangan", "ch": "请洗手。", "cp": "Qǐng xǐ shǒu.", "ca": "Tolong cuci tangan."}]