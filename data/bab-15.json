[{"h": "全", "p": "quán", "a": "seluruh / semua", "ch": "这是我们全家的照片。", "cp": "Zhè shì wǒmen quán jiā de zhàopiàn.", "ca": "Ini foto seluruh keluarga kami."}, {"h": "照片", "p": "zhàopiàn", "a": "foto", "ch": "这张照片很好看。", "cp": "Zhè zhāng zhàopiàn hěn hǎokàn.", "ca": "Foto ini bagus."}, {"h": "看", "p": "kàn", "a": "melihat / menonton / membaca", "ch": "我看看你的照片。", "cp": "Wǒ kànkan nǐ de zhàopiàn.", "ca": "Saya lihat-lihat fotomu."}, {"h": "姐姐", "p": "jiějie", "a": "kakak perempuan", "ch": "我姐姐是大夫。", "cp": "Wǒ jiějie shì dàifu.", "ca": "Kakak perempuan saya dokter."}, {"h": "只", "p": "zhǐ", "a": "hanya", "ch": "我只有两个弟弟。", "cp": "Wǒ zhǐ yǒu liǎng gè dìdi.", "ca": "Saya hanya punya dua adik laki-laki."}, {"h": "做", "p": "zuò", "a": "melakukan / mengerjakan", "ch": "你爸爸做什么工作？", "cp": "Nǐ bàba zuò shénme gōngzuò?", "ca": "Ayahmu bekerja sebagai apa?"}, {"h": "大夫", "p": "dàifu", "a": "dokter", "ch": "她是医院的大夫。", "cp": "Tā shì yīyuàn de dàifu.", "ca": "Dia dokter di rumah sakit."}, {"h": "医院", "p": "yīyuàn", "a": "rumah sakit", "ch": "我姐姐在医院工作。", "cp": "Wǒ jiějie zài yīyuàn gōngzuò.", "ca": "Kakak perempuan saya bekerja di rumah sakit."}, {"h": "公司", "p": "gōngsī", "a": "perusahaan", "ch": "你们公司有多少职员？", "cp": "Nǐmen gōngsī yǒu duōshao zhíyuán?", "ca": "Perusahaan kalian punya berapa pegawai?"}, {"h": "商店", "p": "shāngdiàn", "a": "toko", "ch": "我妈妈在商店工作。", "cp": "Wǒ māma zài shāngdiàn gōngzuò.", "ca": "Ibu saya bekerja di toko."}, {"h": "律师", "p": "lǜshī", "a": "pengacara", "ch": "我哥哥是律师。", "cp": "Wǒ gēge shì lǜshī.", "ca": "Kakak laki-laki saya pengacara."}, {"h": "外贸", "p": "wàimào", "a": "perdagangan luar negeri", "ch": "他在外贸公司工作。", "cp": "Tā zài wàimào gōngsī gōngzuò.", "ca": "Dia bekerja di perusahaan perdagangan luar negeri."}, {"h": "小", "p": "xiǎo", "a": "kecil", "ch": "我们公司很小。", "cp": "Wǒmen gōngsī hěn xiǎo.", "ca": "Perusahaan kami kecil."}, {"h": "大概", "p": "dàgài", "a": "kira-kira / mungkin", "ch": "大概有一百多个职员。", "cp": "Dàgài yǒu yì bǎi duō gè zhíyuán.", "ca": "Kira-kira ada seratus lebih pegawai."}, {"h": "多", "p": "duō", "a": "lebih (setelah bilangan)", "ch": "我们班有二十多个学生。", "cp": "Wǒmen bān yǒu èrshí duō gè xuésheng.", "ca": "Kelas kami ada dua puluh lebih pelajar."}, {"h": "外国", "p": "wàiguó", "a": "luar negeri / asing", "ch": "也有外国职员。", "cp": "Yě yǒu wàiguó zhíyuán.", "ca": "Ada juga pegawai asing."}]