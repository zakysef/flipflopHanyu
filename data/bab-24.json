[{"h": "会", "p": "huì", "a": "bisa (keterampilan hasil belajar)", "ch": "你会打太极拳吗？", "cp": "Nǐ huì dǎ tàijíquán ma?", "ca": "Apakah kamu bisa taiji?"}, {"h": "打", "p": "dǎ", "a": "bermain / berlatih (olahraga)", "ch": "我每天早上打太极拳。", "cp": "Wǒ měi tiān zǎoshang dǎ tàijíquán.", "ca": "Setiap pagi saya berlatih taiji."}, {"h": "太极拳", "p": "tàijíquán", "a": "taiji (taichi)", "ch": "我想学太极拳。", "cp": "Wǒ xiǎng xué tàijíquán.", "ca": "Saya ingin belajar taiji."}, {"h": "听说", "p": "tīngshuō", "a": "dengar-dengar / kabarnya", "ch": "听说你会唱京剧。", "cp": "Tīngshuō nǐ huì chàng jīngjù.", "ca": "Kabarnya kamu bisa menyanyikan opera Peking."}, {"h": "下", "p": "xià", "a": "berikutnya / depan (minggu, bulan)", "ch": "下星期一开始上课。", "cp": "Xià xīngqīyī kāishǐ shàng kè.", "ca": "Senin depan mulai kelas."}, {"h": "报名", "p": "bào míng", "a": "mendaftar", "ch": "我想报名学太极拳。", "cp": "Wǒ xiǎng bào míng xué tàijíquán.", "ca": "Saya ingin mendaftar belajar taiji."}, {"h": "开始", "p": "kāishǐ", "a": "mulai", "ch": "下星期开始上课。", "cp": "Xià xīngqī kāishǐ shàng kè.", "ca": "Minggu depan mulai kelas."}, {"h": "能", "p": "néng", "a": "bisa / dapat (kemampuan / kondisi)", "ch": "她今天不能来上课。", "cp": "Tā jīntiān bù néng lái shàng kè.", "ca": "Hari ini dia tidak bisa masuk kelas."}, {"h": "再", "p": "zài", "a": "lagi / sekali lagi", "ch": "请您再说一遍。", "cp": "Qǐng nín zài shuō yí biàn.", "ca": "Tolong ulangi sekali lagi."}, {"h": "遍", "p": "biàn", "a": "kali (dari awal sampai akhir)", "ch": "请你再读一遍课文。", "cp": "Qǐng nǐ zài dú yí biàn kèwén.", "ca": "Tolong baca teksnya sekali lagi."}, {"h": "懂", "p": "dǒng", "a": "mengerti / paham", "ch": "你懂了吗？", "cp": "Nǐ dǒng le ma?", "ca": "Kamu sudah paham?"}, {"h": "舒服", "p": "shūfu", "a": "nyaman / enak badan", "ch": "我今天有点儿不舒服。", "cp": "Wǒ jīntiān yǒudiǎnr bù shūfu.", "ca": "Hari ini saya agak tidak enak badan."}, {"h": "意思", "p": "yìsi", "a": "arti / maksud", "ch": "这个字是什么意思？", "cp": "Zhège zì shì shénme yìsi?", "ca": "Huruf ini artinya apa?"}, {"h": "次", "p": "cì", "a": "kali (frekuensi)", "ch": "一星期上两次课。", "cp": "Yì xīngqī shàng liǎng cì kè.", "ca": "Seminggu dua kali kelas."}, {"h": "小时", "p": "xiǎoshí", "a": "jam (durasi)", "ch": "一次一个小时。", "cp": "Yí cì yí gè xiǎoshí.", "ca": "Sekali pertemuan satu jam."}, {"h": "请假", "p": "qǐng jià", "a": "minta izin (tidak masuk)", "ch": "我今天要请假。", "cp": "Wǒ jīntiān yào qǐng jià.", "ca": "Hari ini saya mau minta izin."}, {"h": "头疼", "p": "tóu téng", "a": "sakit kepala", "ch": "我有点儿头疼。", "cp": "Wǒ yǒudiǎnr tóu téng.", "ca": "Saya agak sakit kepala."}, {"h": "头", "p": "tóu", "a": "kepala", "ch": "我的头很疼。", "cp": "Wǒ de tóu hěn téng.", "ca": "Kepala saya sakit sekali."}, {"h": "疼", "p": "téng", "a": "sakit / nyeri", "ch": "现在不疼了。", "cp": "Xiànzài bù téng le.", "ca": "Sekarang sudah tidak sakit."}, {"h": "发烧", "p": "fā shāo", "a": "demam", "ch": "她发烧了。", "cp": "Tā fā shāo le.", "ca": "Dia demam."}, {"h": "可能", "p": "kěnéng", "a": "mungkin", "ch": "她可能感冒了。", "cp": "Tā kěnéng gǎnmào le.", "ca": "Dia mungkin masuk angin."}, {"h": "咳嗽", "p": "késou", "a": "batuk", "ch": "他咳嗽，头也疼。", "cp": "Tā késou, tóu yě téng.", "ca": "Dia batuk, kepalanya juga sakit."}, {"h": "感冒", "p": "gǎnmào", "a": "flu / masuk angin", "ch": "我感冒了。", "cp": "Wǒ gǎnmào le.", "ca": "Saya kena flu."}, {"h": "了", "p": "le", "a": "partikel perubahan keadaan", "ch": "我是大学生了。", "cp": "Wǒ shì dàxuéshēng le.", "ca": "Sekarang saya sudah jadi mahasiswa."}, {"h": "看病", "p": "kàn bìng", "a": "berobat (ke dokter)", "ch": "她要去医院看病。", "cp": "Tā yào qù yīyuàn kàn bìng.", "ca": "Dia mau berobat ke rumah sakit."}, {"h": "病", "p": "bìng", "a": "penyakit / sakit", "ch": "他病了。", "cp": "Tā bìng le.", "ca": "Dia sakit."}]