[{"h": "买", "p": "mǎi", "a": "membeli", "ch": "我买水果。", "cp": "Wǒ mǎi shuǐguǒ.", "ca": "Saya membeli buah."}, {"h": "水果", "p": "shuǐguǒ", "a": "buah-buahan", "ch": "我喜欢吃水果。", "cp": "Wǒ xǐhuan chī shuǐguǒ.", "ca": "Saya suka makan buah."}, {"h": "苹果", "p": "píngguǒ", "a": "apel", "ch": "苹果一斤多少钱？", "cp": "Píngguǒ yì jīn duōshao qián?", "ca": "Apel satu jin berapa?"}, {"h": "斤", "p": "jīn", "a": "jin (satuan berat = 0,5 kg)", "ch": "我买两斤苹果。", "cp": "Wǒ mǎi liǎng jīn píngguǒ.", "ca": "Saya beli dua jin apel."}, {"h": "公斤", "p": "gōngjīn", "a": "kilogram", "ch": "一公斤多少钱？", "cp": "Yì gōngjīn duōshao qián?", "ca": "Satu kilogram berapa?"}, {"h": "贵", "p": "guì", "a": "mahal", "ch": "太贵了！", "cp": "Tài guì le!", "ca": "Terlalu mahal!"}, {"h": "了", "p": "le", "a": "partikel modal (sudah)", "ch": "太贵了！", "cp": "Tài guì le!", "ca": "Mahal sekali!"}, {"h": "吧", "p": "ba", "a": "partikel ajakan / saran", "ch": "我们走吧。", "cp": "Wǒmen zǒu ba.", "ca": "Ayo kita pergi."}, {"h": "多少", "p": "duōshao", "a": "berapa (jumlah)", "ch": "苹果多少钱？", "cp": "Píngguǒ duōshao qián?", "ca": "Apel berapa harganya?"}, {"h": "多", "p": "duō", "a": "banyak", "ch": "人很多。", "cp": "Rén hěn duō.", "ca": "Orangnya banyak."}, {"h": "少", "p": "shǎo", "a": "sedikit", "ch": "钱太少了。", "cp": "Qián tài shǎo le.", "ca": "Uangnya terlalu sedikit."}, {"h": "块", "p": "kuài", "a": "kuai (satuan uang, lisan)", "ch": "五块钱。", "cp": "Wǔ kuài qián.", "ca": "Lima yuan."}, {"h": "元", "p": "yuán", "a": "yuan (satuan uang, tulisan)", "ch": "十元。", "cp": "Shí yuán.", "ca": "Sepuluh yuan."}, {"h": "角", "p": "jiǎo", "a": "jiao (1/10 yuan)", "ch": "五角钱。", "cp": "Wǔ jiǎo qián.", "ca": "Lima jiao."}, {"h": "毛", "p": "máo", "a": "mao (sebutan lisan untuk jiao)", "ch": "三毛钱。", "cp": "Sān máo qián.", "ca": "Tiga mao."}, {"h": "分", "p": "fēn", "a": "fen (1/100 yuan)", "ch": "五分钱。", "cp": "Wǔ fēn qián.", "ca": "Lima fen."}, {"h": "还", "p": "hái", "a": "masih / lagi / juga", "ch": "我还要别的。", "cp": "Wǒ hái yào biéde.", "ca": "Saya masih mau yang lain."}, {"h": "别的", "p": "biéde", "a": "yang lain", "ch": "还要别的吗？", "cp": "Hái yào biéde ma?", "ca": "Mau yang lain lagi?"}, {"h": "橘子", "p": "júzi", "a": "jeruk", "ch": "橘子怎么卖？", "cp": "Júzi zěnme mài?", "ca": "Jeruk dijual berapa?"}, {"h": "怎么", "p": "zěnme", "a": "bagaimana", "ch": "这个怎么卖？", "cp": "Zhège zěnme mài?", "ca": "Ini dijual bagaimana (berapa)?"}, {"h": "卖", "p": "mài", "a": "menjual", "ch": "苹果怎么卖？", "cp": "Píngguǒ zěnme mài?", "ca": "Apel dijual berapa?"}, {"h": "两", "p": "liǎng", "a": "dua (+ kata penggolong)", "ch": "我买两斤。", "cp": "Wǒ mǎi liǎng jīn.", "ca": "Saya beli dua jin."}, {"h": "一共", "p": "yígòng", "a": "total / semuanya", "ch": "一共多少钱？", "cp": "Yígòng duōshao qián?", "ca": "Totalnya berapa?"}, {"h": "给", "p": "gěi", "a": "memberi", "ch": "给你钱。", "cp": "Gěi nǐ qián.", "ca": "Ini uangnya untukmu."}, {"h": "找", "p": "zhǎo", "a": "memberi kembalian", "ch": "找您三十四块。", "cp": "Zhǎo nín sānshísì kuài.", "ca": "Kembaliannya 34 yuan."}]