[{"h": "在", "p": "zài", "a": "sedang (melakukan)", "ch": "他在做什么呢？", "cp": "Tā zài zuò shénme ne?", "ca": "Dia sedang apa?"}, {"h": "出来", "p": "chūlai", "a": "keluar (ke arah pembicara)", "ch": "他出来了。", "cp": "Tā chūlai le.", "ca": "Dia sudah keluar."}, {"h": "来", "p": "lái", "a": "datang", "ch": "明天你来吗？", "cp": "Míngtiān nǐ lái ma?", "ca": "Besok kamu datang?"}, {"h": "正在", "p": "zhèngzài", "a": "sedang (berlangsung)", "ch": "他正在听音乐。", "cp": "Tā zhèngzài tīng yīnyuè.", "ca": "Dia sedang mendengarkan musik."}, {"h": "音乐", "p": "yīnyuè", "a": "musik", "ch": "我在听音乐。", "cp": "Wǒ zài tīng yīnyuè.", "ca": "Saya sedang mendengarkan musik."}, {"h": "没有", "p": "méiyǒu", "a": "tidak (sedang); belum", "ch": "他没有看电视。", "cp": "Tā méiyǒu kàn diànshì.", "ca": "Dia tidak sedang menonton TV."}, {"h": "正", "p": "zhèng", "a": "sedang / tepat sedang", "ch": "我正看书呢。", "cp": "Wǒ zhèng kàn shū ne.", "ca": "Saya sedang membaca buku."}, {"h": "录音", "p": "lùyīn", "a": "rekaman / merekam", "ch": "他在听录音。", "cp": "Tā zài tīng lùyīn.", "ca": "Dia sedang mendengarkan rekaman."}, {"h": "事", "p": "shì", "a": "urusan / hal", "ch": "你有什么事？", "cp": "Nǐ yǒu shénme shì?", "ca": "Ada urusan apa?"}, {"h": "书店", "p": "shūdiàn", "a": "toko buku", "ch": "我想去书店买书。", "cp": "Wǒ xiǎng qù shūdiàn mǎi shū.", "ca": "Saya ingin ke toko buku membeli buku."}, {"h": "想", "p": "xiǎng", "a": "ingin; berpikir / merindukan", "ch": "我想买一本词典。", "cp": "Wǒ xiǎng mǎi yì běn cídiǎn.", "ca": "Saya ingin membeli sebuah kamus."}, {"h": "汉英", "p": "Hàn-Yīng", "a": "Mandarin–Inggris", "ch": "我想买一本汉英词典。", "cp": "Wǒ xiǎng mǎi yì běn Hàn-Yīng cídiǎn.", "ca": "Saya ingin membeli kamus Mandarin–Inggris."}, {"h": "坐", "p": "zuò", "a": "naik (kendaraan)", "ch": "我们坐车去吧。", "cp": "Wǒmen zuò chē qù ba.", "ca": "Ayo kita pergi naik kendaraan."}, {"h": "挤", "p": "jǐ", "a": "penuh sesak / berdesakan", "ch": "汽车上人很多，太挤了。", "cp": "Qìchē shang rén hěn duō, tài jǐ le.", "ca": "Di bus banyak orang, terlalu sesak."}, {"h": "骑", "p": "qí", "a": "mengendarai (sepeda / motor / kuda)", "ch": "咱们骑车去吧。", "cp": "Zánmen qí chē qù ba.", "ca": "Ayo kita naik sepeda."}, {"h": "行", "p": "xíng", "a": "boleh / oke", "ch": "行，咱们走吧。", "cp": "Xíng, zánmen zǒu ba.", "ca": "Oke, ayo kita pergi."}, {"h": "门", "p": "mén", "a": "(penggolong mata pelajaran)", "ch": "你们有几门课？", "cp": "Nǐmen yǒu jǐ mén kè?", "ca": "Kalian punya berapa mata pelajaran?"}, {"h": "课", "p": "kè", "a": "pelajaran / kelas", "ch": "现在只有四门课。", "cp": "Xiànzài zhǐ yǒu sì mén kè.", "ca": "Sekarang hanya ada empat mata pelajaran."}, {"h": "综合", "p": "zōnghé", "a": "komprehensif / terpadu", "ch": "王老师教我们综合课。", "cp": "Wáng lǎoshī jiāo wǒmen zōnghé kè.", "ca": "Guru Wang mengajar kami pelajaran terpadu."}, {"h": "口语", "p": "kǒuyǔ", "a": "bahasa lisan / percakapan", "ch": "口语课不太难。", "cp": "Kǒuyǔ kè bú tài nán.", "ca": "Pelajaran percakapan tidak terlalu sulit."}, {"h": "听力", "p": "tīnglì", "a": "menyimak (listening)", "ch": "林老师教我们听力。", "cp": "Lín lǎoshī jiāo wǒmen tīnglì.", "ca": "Guru Lin mengajar kami menyimak."}, {"h": "阅读", "p": "yuèdú", "a": "membaca (pemahaman)", "ch": "阅读课比较难。", "cp": "Yuèdú kè bǐjiào nán.", "ca": "Pelajaran membaca cukup sulit."}, {"h": "文化", "p": "wénhuà", "a": "budaya", "ch": "我想学习中国文化。", "cp": "Wǒ xiǎng xuéxí Zhōngguó wénhuà.", "ca": "Saya ingin belajar budaya China."}, {"h": "体育", "p": "tǐyù", "a": "olahraga / pendidikan jasmani", "ch": "我们没有体育课。", "cp": "Wǒmen méiyǒu tǐyù kè.", "ca": "Kami tidak punya pelajaran olahraga."}, {"h": "教", "p": "jiāo", "a": "mengajar", "ch": "谁教你们语法？", "cp": "Shéi jiāo nǐmen yǔfǎ?", "ca": "Siapa yang mengajar kalian tata bahasa?"}]