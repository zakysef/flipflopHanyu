[{"h": "叫", "p": "jiào", "a": "menyuruh / meminta", "ch": "老师叫我去办公室。", "cp": "Lǎoshī jiào wǒ qù bàngōngshì.", "ca": "Guru menyuruh saya ke kantor."}, {"h": "让", "p": "ràng", "a": "menyuruh / membiarkan", "ch": "老师让我们谈谈自己的爱好。", "cp": "Lǎoshī ràng wǒmen tántan zìjǐ de àihào.", "ca": "Guru menyuruh kami membicarakan hobi masing-masing."}, {"h": "大家", "p": "dàjiā", "a": "semua orang / semuanya", "ch": "大家好！", "cp": "Dàjiā hǎo!", "ca": "Halo semuanya!"}, {"h": "谈", "p": "tán", "a": "membicarakan", "ch": "我们谈谈学习吧。", "cp": "Wǒmen tántan xuéxí ba.", "ca": "Mari kita bicarakan soal belajar."}, {"h": "自己", "p": "zìjǐ", "a": "diri sendiri", "ch": "我自己去吧。", "cp": "Wǒ zìjǐ qù ba.", "ca": "Saya pergi sendiri saja."}, {"h": "爱好", "p": "àihào", "a": "hobi / gemar", "ch": "你有什么爱好？", "cp": "Nǐ yǒu shénme àihào?", "ca": "Apa hobimu?"}, {"h": "京剧", "p": "jīngjù", "a": "opera Peking", "ch": "你喜欢看京剧吗？", "cp": "Nǐ xǐhuan kàn jīngjù ma?", "ca": "Apakah kamu suka menonton opera Peking?"}, {"h": "喜欢", "p": "xǐhuan", "a": "suka", "ch": "我喜欢听音乐。", "cp": "Wǒ xǐhuan tīng yīnyuè.", "ca": "Saya suka mendengarkan musik."}, {"h": "非常", "p": "fēicháng", "a": "sangat / amat", "ch": "我非常喜欢京剧。", "cp": "Wǒ fēicháng xǐhuan jīngjù.", "ca": "Saya sangat suka opera Peking."}, {"h": "唱", "p": "chàng", "a": "menyanyi", "ch": "她喜欢唱京剧。", "cp": "Tā xǐhuan chàng jīngjù.", "ca": "Dia suka menyanyikan opera Peking."}, {"h": "玩", "p": "wán", "a": "bermain", "ch": "我喜欢玩电脑。", "cp": "Wǒ xǐhuan wán diànnǎo.", "ca": "Saya suka main komputer."}, {"h": "电脑", "p": "diànnǎo", "a": "komputer", "ch": "我常常用电脑上网。", "cp": "Wǒ chángcháng yòng diànnǎo shàng wǎng.", "ca": "Saya sering online pakai komputer."}, {"h": "下课", "p": "xià kè", "a": "selesai kelas", "ch": "下课以后，我去图书馆。", "cp": "Xià kè yǐhòu, wǒ qù túshūguǎn.", "ca": "Setelah kelas selesai, saya ke perpustakaan."}, {"h": "感到", "p": "gǎndào", "a": "merasa", "ch": "我感到很高兴。", "cp": "Wǒ gǎndào hěn gāoxìng.", "ca": "Saya merasa sangat senang."}, {"h": "心情", "p": "xīnqíng", "a": "suasana hati / mood", "ch": "今天我心情很好。", "cp": "Jīntiān wǒ xīnqíng hěn hǎo.", "ca": "Hari ini suasana hati saya baik."}, {"h": "愉快", "p": "yúkuài", "a": "gembira / menyenangkan", "ch": "唱京剧的时候，我心情很愉快。", "cp": "Chàng jīngjù de shíhou, wǒ xīnqíng hěn yúkuài.", "ca": "Saat menyanyikan opera Peking, hati saya gembira."}, {"h": "业余", "p": "yèyú", "a": "waktu luang / amatir", "ch": "你业余时间喜欢做什么？", "cp": "Nǐ yèyú shíjiān xǐhuan zuò shénme?", "ca": "Di waktu luang kamu suka melakukan apa?"}, {"h": "以前", "p": "yǐqián", "a": "dulu / sebelum", "ch": "以前我不喜欢京剧。", "cp": "Yǐqián wǒ bù xǐhuan jīngjù.", "ca": "Dulu saya tidak suka opera Peking."}, {"h": "就", "p": "jiù", "a": "sudah (sejak)", "ch": "我来中国以前就对书法感兴趣。", "cp": "Wǒ lái Zhōngguó yǐqián jiù duì shūfǎ gǎn xìngqù.", "ca": "Sebelum datang ke China saya sudah tertarik pada kaligrafi."}, {"h": "对", "p": "duì", "a": "terhadap / kepada", "ch": "我对京剧感兴趣。", "cp": "Wǒ duì jīngjù gǎn xìngqù.", "ca": "Saya tertarik pada opera Peking."}, {"h": "书法", "p": "shūfǎ", "a": "kaligrafi", "ch": "我喜欢中国书法。", "cp": "Wǒ xǐhuan Zhōngguó shūfǎ.", "ca": "Saya suka kaligrafi China."}, {"h": "特别", "p": "tèbié", "a": "khususnya / sangat", "ch": "我特别喜欢唱京剧。", "cp": "Wǒ tèbié xǐhuan chàng jīngjù.", "ca": "Saya sangat suka menyanyikan opera Peking."}, {"h": "感兴趣", "p": "gǎn xìngqù", "a": "tertarik (pada)", "ch": "我对中国文化很感兴趣。", "cp": "Wǒ duì Zhōngguó wénhuà hěn gǎn xìngqù.", "ca": "Saya sangat tertarik pada budaya China."}, {"h": "兴趣", "p": "xìngqù", "a": "minat", "ch": "他对书法有兴趣。", "cp": "Tā duì shūfǎ yǒu xìngqù.", "ca": "Dia berminat pada kaligrafi."}, {"h": "派", "p": "pài", "a": "mengutus / mengirim (orang)", "ch": "公司派他去上海。", "cp": "Gōngsī pài tā qù Shànghǎi.", "ca": "Perusahaan mengutusnya ke Shanghai."}, {"h": "高兴", "p": "gāoxìng", "a": "senang / gembira", "ch": "今天我很高兴。", "cp": "Jīntiān wǒ hěn gāoxìng.", "ca": "Hari ini saya sangat senang."}, {"h": "画", "p": "huà", "a": "menggambar / melukis", "ch": "他喜欢画画儿。", "cp": "Tā xǐhuan huà huàr.", "ca": "Dia suka menggambar."}, {"h": "画儿", "p": "huàr", "a": "lukisan / gambar", "ch": "这张画儿很好看。", "cp": "Zhè zhāng huàr hěn hǎokàn.", "ca": "Lukisan ini bagus."}]