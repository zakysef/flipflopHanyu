[{"h": "电视台", "p": "diànshìtái", "a": "stasiun televisi", "ch": "他在电视台工作。", "cp": "Tā zài diànshìtái gōngzuò.", "ca": "Dia bekerja di stasiun televisi."}, {"h": "台", "p": "tái", "a": "stasiun (siaran)", "ch": "这个电视台有很多好节目。", "cp": "Zhège diànshìtái yǒu hěn duō hǎo jiémù.", "ca": "Stasiun TV ini punya banyak acara bagus."}, {"h": "表演", "p": "biǎoyǎn", "a": "tampil; mementaskan", "ch": "她明天要表演京剧。", "cp": "Tā míngtiān yào biǎoyǎn jīngjù.", "ca": "Besok dia akan tampil membawakan opera Beijing."}, {"h": "节目", "p": "jiémù", "a": "acara; program", "ch": "我喜欢看这个节目。", "cp": "Wǒ xǐhuan kàn zhège jiémù.", "ca": "Saya suka menonton acara ini."}, {"h": "愿意", "p": "yuànyì", "a": "bersedia; mau", "ch": "你愿意帮我吗？", "cp": "Nǐ yuànyì bāng wǒ ma?", "ca": "Apakah kamu bersedia membantuku?"}, {"h": "为什么", "p": "wèi shénme", "a": "mengapa", "ch": "你为什么学汉语？", "cp": "Nǐ wèi shénme xué Hànyǔ?", "ca": "Mengapa kamu belajar bahasa Mandarin?"}, {"h": "得", "p": "de", "a": "partikel penghubung verba dan komplemen (derajat/keadaan)", "ch": "她说得很好。", "cp": "Tā shuō de hěn hǎo.", "ca": "Dia berbicara dengan sangat baik."}, {"h": "不错", "p": "búcuò", "a": "lumayan bagus; tidak buruk", "ch": "这个电影不错。", "cp": "Zhège diànyǐng búcuò.", "ca": "Film ini lumayan bagus."}, {"h": "错", "p": "cuò", "a": "salah", "ch": "这个字写错了。", "cp": "Zhège zì xiě cuò le.", "ca": "Karakter ini salah tulis."}, {"h": "进步", "p": "jìnbù", "a": "maju; membuat kemajuan", "ch": "你的汉语进步很快。", "cp": "Nǐ de Hànyǔ jìnbù hěn kuài.", "ca": "Bahasa Mandarinmu cepat maju."}, {"h": "水平", "p": "shuǐpíng", "a": "tingkat; level (kemampuan)", "ch": "他的汉语水平很高。", "cp": "Tā de Hànyǔ shuǐpíng hěn gāo.", "ca": "Level bahasa Mandarinnya tinggi."}, {"h": "提高", "p": "tígāo", "a": "meningkatkan", "ch": "我想提高我的汉语水平。", "cp": "Wǒ xiǎng tígāo wǒ de Hànyǔ shuǐpíng.", "ca": "Saya ingin meningkatkan level bahasa Mandarin saya."}, {"h": "快", "p": "kuài", "a": "cepat", "ch": "他吃饭吃得很快。", "cp": "Tā chī fàn chī de hěn kuài.", "ca": "Dia makan dengan cepat."}, {"h": "哪里", "p": "nǎli", "a": "ah, tidak juga (jawaban rendah hati atas pujian)", "ch": "你的汉语真好！——哪里，哪里。", "cp": "Nǐ de Hànyǔ zhēn hǎo! —— Nǎli, nǎli.", "ca": "Bahasa Mandarinmu bagus sekali! — Ah, tidak juga."}, {"h": "准", "p": "zhǔn", "a": "tepat; akurat", "ch": "他的发音很准。", "cp": "Tā de fāyīn hěn zhǔn.", "ca": "Pelafalannya sangat tepat."}, {"h": "流利", "p": "liúlì", "a": "lancar", "ch": "她的英语说得很流利。", "cp": "Tā de Yīngyǔ shuō de hěn liúlì.", "ca": "Dia berbicara bahasa Inggris dengan sangat lancar."}, {"h": "努力", "p": "nǔlì", "a": "giat; berusaha keras", "ch": "他学习很努力。", "cp": "Tā xuéxí hěn nǔlì.", "ca": "Dia belajar dengan sangat giat."}, {"h": "认真", "p": "rènzhēn", "a": "sungguh-sungguh; teliti", "ch": "她做作业很认真。", "cp": "Tā zuò zuòyè hěn rènzhēn.", "ca": "Dia mengerjakan PR dengan sungguh-sungguh."}, {"h": "看", "p": "kàn", "a": "menilai; berpendapat", "ch": "你看这件衣服怎么样？", "cp": "Nǐ kàn zhè jiàn yīfu zěnmeyàng?", "ca": "Menurutmu baju ini bagaimana?"}, {"h": "为", "p": "wèi", "a": "untuk; demi", "ch": "我为你高兴。", "cp": "Wǒ wèi nǐ gāoxìng.", "ca": "Saya senang untukmu."}, {"h": "这么", "p": "zhème", "a": "begini; sebegini", "ch": "今天这么冷！", "cp": "Jīntiān zhème lěng!", "ca": "Hari ini dingin sekali!"}, {"h": "那么", "p": "nàme", "a": "begitu; sebegitu", "ch": "他跑得那么快。", "cp": "Tā pǎo de nàme kuài.", "ca": "Dia berlari begitu cepat."}, {"h": "早", "p": "zǎo", "a": "pagi; awal; dini", "ch": "他起得很早。", "cp": "Tā qǐ de hěn zǎo.", "ca": "Dia bangun sangat pagi."}, {"h": "运动", "p": "yùndòng", "a": "berolahraga", "ch": "我每天早上运动。", "cp": "Wǒ měitiān zǎoshang yùndòng.", "ca": "Setiap pagi saya berolahraga."}, {"h": "跑步", "p": "pǎo bù", "a": "berlari; jogging", "ch": "他喜欢跑步。", "cp": "Tā xǐhuan pǎo bù.", "ca": "Dia suka berlari."}, {"h": "跑", "p": "pǎo", "a": "berlari", "ch": "我们一起跑吧。", "cp": "Wǒmen yìqǐ pǎo ba.", "ca": "Ayo kita berlari bersama."}, {"h": "篮球", "p": "lánqiú", "a": "bola basket", "ch": "他打篮球打得很好。", "cp": "Tā dǎ lánqiú dǎ de hěn hǎo.", "ca": "Dia bermain basket dengan sangat baik."}, {"h": "球", "p": "qiú", "a": "bola", "ch": "这个球很大。", "cp": "Zhège qiú hěn dà.", "ca": "Bola ini besar sekali."}, {"h": "刚才", "p": "gāngcái", "a": "tadi; baru saja", "ch": "刚才有人找你。", "cp": "Gāngcái yǒu rén zhǎo nǐ.", "ca": "Tadi ada orang mencarimu."}, {"h": "可以", "p": "kěyǐ", "a": "lumayan; boleh juga", "ch": "这家饭馆儿的菜还可以。", "cp": "Zhè jiā fànguǎnr de cài hái kěyǐ.", "ca": "Masakan restoran ini lumayan."}, {"h": "坚持", "p": "jiānchí", "a": "bertahan; tetap melakukan", "ch": "他每天坚持跑步。", "cp": "Tā měitiān jiānchí pǎo bù.", "ca": "Dia setiap hari tetap berlari."}, {"h": "因为", "p": "yīnwèi", "a": "karena", "ch": "因为下雨，我没去。", "cp": "Yīnwèi xià yǔ, wǒ méi qù.", "ca": "Karena hujan, saya tidak pergi."}, {"h": "晚", "p": "wǎn", "a": "malam; larut; terlambat", "ch": "他睡得很晚。", "cp": "Tā shuì de hěn wǎn.", "ca": "Dia tidur larut malam."}]