[{"h": "包裹", "p": "bāoguǒ", "a": "paket / bingkisan", "ch": "我去邮局寄包裹。", "cp": "Wǒ qù yóujú jì bāoguǒ.", "ca": "Saya ke kantor pos mengirim paket."}, {"h": "顺便", "p": "shùnbiàn", "a": "sekalian", "ch": "你顺便替我买几张邮票吧。", "cp": "Nǐ shùnbiàn tì wǒ mǎi jǐ zhāng yóupiào ba.", "ca": "Sekalian tolong belikan saya beberapa perangko."}, {"h": "替", "p": "tì", "a": "untuk / menggantikan", "ch": "你替我买一份报吧。", "cp": "Nǐ tì wǒ mǎi yí fèn bào ba.", "ca": "Tolong belikan saya satu koran."}, {"h": "邮票", "p": "yóupiào", "a": "perangko", "ch": "我买三张邮票。", "cp": "Wǒ mǎi sān zhāng yóupiào.", "ca": "Saya beli tiga lembar perangko."}, {"h": "份", "p": "fèn", "a": "(penggolong koran / dokumen)", "ch": "一份报纸。", "cp": "Yí fèn bàozhǐ.", "ca": "Satu eksemplar koran."}, {"h": "青年", "p": "qīngnián", "a": "pemuda", "ch": "他是一个好青年。", "cp": "Tā shì yí gè hǎo qīngnián.", "ca": "Dia pemuda yang baik."}, {"h": "报", "p": "bào", "a": "koran", "ch": "我常常看报。", "cp": "Wǒ chángcháng kàn bào.", "ca": "Saya sering membaca koran."}, {"h": "报纸", "p": "bàozhǐ", "a": "koran", "ch": "这是今天的报纸。", "cp": "Zhè shì jīntiān de bàozhǐ.", "ca": "Ini koran hari ini."}, {"h": "拿", "p": "ná", "a": "mengambil / membawa (dengan tangan)", "ch": "我去拿包裹。", "cp": "Wǒ qù ná bāoguǒ.", "ca": "Saya pergi mengambil paket."}, {"h": "不用", "p": "búyòng", "a": "tidak perlu", "ch": "不用了，谢谢。", "cp": "Búyòng le, xièxie.", "ca": "Tidak usah, terima kasih."}, {"h": "用", "p": "yòng", "a": "memakai / menggunakan", "ch": "我用一下儿你的词典，行吗？", "cp": "Wǒ yòng yíxiàr nǐ de cídiǎn, xíng ma?", "ca": "Saya pakai kamusmu sebentar, boleh?"}, {"h": "旅行", "p": "lǚxíng", "a": "bepergian / berwisata", "ch": "我们去上海旅行。", "cp": "Wǒmen qù Shànghǎi lǚxíng.", "ca": "Kami berwisata ke Shanghai."}, {"h": "代表", "p": "dàibiǎo", "a": "wakil / mewakili", "ch": "他是我们班的代表。", "cp": "Tā shì wǒmen bān de dàibiǎo.", "ca": "Dia wakil kelas kami."}, {"h": "团", "p": "tuán", "a": "rombongan / delegasi", "ch": "他们是外贸代表团。", "cp": "Tāmen shì wàimào dàibiǎotuán.", "ca": "Mereka delegasi perdagangan luar negeri."}, {"h": "参观", "p": "cānguān", "a": "berkunjung (melihat-lihat)", "ch": "代表团去上海参观。", "cp": "Dàibiǎotuán qù Shànghǎi cānguān.", "ca": "Delegasi berkunjung ke Shanghai."}, {"h": "当", "p": "dāng", "a": "menjadi / bertugas sebagai", "ch": "我给代表团当翻译。", "cp": "Wǒ gěi dàibiǎotuán dāng fānyì.", "ca": "Saya menjadi penerjemah untuk delegasi."}, {"h": "翻译", "p": "fānyì", "a": "penerjemah / menerjemahkan", "ch": "他是汉语翻译。", "cp": "Tā shì Hànyǔ fānyì.", "ca": "Dia penerjemah bahasa Mandarin."}, {"h": "飞机", "p": "fēijī", "a": "pesawat terbang", "ch": "我们坐飞机去。", "cp": "Wǒmen zuò fēijī qù.", "ca": "Kami pergi naik pesawat."}, {"h": "飞", "p": "fēi", "a": "terbang", "ch": "我们明天飞上海。", "cp": "Wǒmen míngtiān fēi Shànghǎi.", "ca": "Besok kami terbang ke Shanghai."}, {"h": "火车", "p": "huǒchē", "a": "kereta api", "ch": "坐火车去还是坐飞机去？", "cp": "Zuò huǒchē qù háishi zuò fēijī qù?", "ca": "Naik kereta atau naik pesawat?"}, {"h": "回来", "p": "huílai", "a": "kembali (ke sini)", "ch": "你什么时候回来？", "cp": "Nǐ shénme shíhou huílai?", "ca": "Kapan kamu kembali?"}, {"h": "办", "p": "bàn", "a": "mengurus / menangani", "ch": "我去银行办事。", "cp": "Wǒ qù yínháng bàn shì.", "ca": "Saya ke bank mengurus sesuatu."}, {"h": "帮", "p": "bāng", "a": "membantu", "ch": "你帮我买邮票，好吗？", "cp": "Nǐ bāng wǒ mǎi yóupiào, hǎo ma?", "ca": "Tolong bantu belikan perangko, ya?"}, {"h": "浇", "p": "jiāo", "a": "menyiram", "ch": "帮我浇一下儿花。", "cp": "Bāng wǒ jiāo yíxiàr huā.", "ca": "Tolong siramkan bunga saya sebentar."}, {"h": "花", "p": "huā", "a": "bunga", "ch": "这是什么花？", "cp": "Zhè shì shénme huā?", "ca": "Ini bunga apa?"}, {"h": "没问题", "p": "méi wèntí", "a": "tidak masalah", "ch": "行，没问题。", "cp": "Xíng, méi wèntí.", "ca": "Oke, tidak masalah."}, {"h": "问题", "p": "wèntí", "a": "pertanyaan / masalah", "ch": "你有问题吗？", "cp": "Nǐ yǒu wèntí ma?", "ca": "Kamu ada pertanyaan?"}]