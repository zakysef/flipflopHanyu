[{"h": "下午", "p": "xiàwǔ", "a": "sore / siang hari", "ch": "下午我去图书馆。", "cp": "Xiàwǔ wǒ qù túshūguǎn.", "ca": "Sore ini saya pergi ke perpustakaan."}, {"h": "上午", "p": "shàngwǔ", "a": "pagi (sebelum tengah hari)", "ch": "上午我有课。", "cp": "Shàngwǔ wǒ yǒu kè.", "ca": "Pagi ini saya ada kelas."}, {"h": "图书馆", "p": "túshūguǎn", "a": "perpustakaan", "ch": "图书馆很大。", "cp": "Túshūguǎn hěn dà.", "ca": "Perpustakaannya sangat besar."}, {"h": "要", "p": "yào", "a": "mau / ingin (+ kata kerja)", "ch": "我要换钱。", "cp": "Wǒ yào huàn qián.", "ca": "Saya mau menukar uang."}, {"h": "换", "p": "huàn", "a": "menukar / mengganti", "ch": "我要换人民币。", "cp": "Wǒ yào huàn rénmínbì.", "ca": "Saya mau menukar ke Renminbi."}, {"h": "小姐", "p": "xiǎojiě", "a": "Nona", "ch": "小姐，您好！", "cp": "Xiǎojiě, nín hǎo!", "ca": "Halo, Nona!"}, {"h": "营业员", "p": "yíngyèyuán", "a": "petugas layanan / pramuniaga", "ch": "她是银行的营业员。", "cp": "Tā shì yínháng de yíngyèyuán.", "ca": "Dia petugas layanan bank."}, {"h": "人民币", "p": "rénmínbì", "a": "Renminbi (RMB)", "ch": "这是人民币。", "cp": "Zhè shì rénmínbì.", "ca": "Ini Renminbi."}, {"h": "人民", "p": "rénmín", "a": "rakyat", "ch": "中国人民很友好。", "cp": "Zhōngguó rénmín hěn yǒuhǎo.", "ca": "Rakyat China ramah."}, {"h": "百", "p": "bǎi", "a": "ratus", "ch": "一百块。", "cp": "Yì bǎi kuài.", "ca": "Seratus yuan."}, {"h": "千", "p": "qiān", "a": "ribu", "ch": "一千块。", "cp": "Yì qiān kuài.", "ca": "Seribu yuan."}, {"h": "万", "p": "wàn", "a": "sepuluh ribu", "ch": "一万块。", "cp": "Yí wàn kuài.", "ca": "Sepuluh ribu yuan."}, {"h": "美元", "p": "měiyuán", "a": "dolar AS", "ch": "我换二百美元。", "cp": "Wǒ huàn èrbǎi měiyuán.", "ca": "Saya menukar dua ratus dolar AS."}, {"h": "港币", "p": "gǎngbì", "a": "dolar Hong Kong", "ch": "港币换人民币。", "cp": "Gǎngbì huàn rénmínbì.", "ca": "Dolar HK ditukar ke RMB."}, {"h": "日元", "p": "rìyuán", "a": "yen Jepang", "ch": "这是日元。", "cp": "Zhè shì rìyuán.", "ca": "Ini yen Jepang."}, {"h": "欧元", "p": "ōuyuán", "a": "Euro", "ch": "我换欧元。", "cp": "Wǒ huàn ōuyuán.", "ca": "Saya menuka