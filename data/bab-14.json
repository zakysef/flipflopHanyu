[{"h": "经理", "p": "jīnglǐ", "a": "manajer", "ch": "经理在办公室。", "cp": "Jīnglǐ zài bàngōngshì.", "ca": "Manajer ada di kantor."}, {"h": "好久", "p": "hǎojiǔ", "a": "lama sekali", "ch": "好久不见！", "cp": "Hǎojiǔ bú jiàn!", "ca": "Lama tidak bertemu!"}, {"h": "啊", "p": "à", "a": "oh! (baru sadar / paham)", "ch": "啊，我的车在那儿呢。", "cp": "À, wǒ de chē zài nàr ne.", "ca": "Oh, mobil saya ada di sana."}, {"h": "马马虎虎", "p": "mǎmahūhū", "a": "biasa saja / lumayan", "ch": "我最近马马虎虎。", "cp": "Wǒ zuìjìn mǎmahūhū.", "ca": "Akhir-akhir ini saya biasa-biasa saja."}, {"h": "最近", "p": "zuìjìn", "a": "akhir-akhir ini", "ch": "最近我很忙。", "cp": "Zuìjìn wǒ hěn máng.", "ca": "Akhir-akhir ini saya sibuk."}, {"h": "刚", "p": "gāng", "a": "baru saja", "ch": "我刚来。", "cp": "Wǒ gāng lái.", "ca": "Saya baru saja datang."}, {"h": "开学", "p": "kāi xué", "a": "mulai semester / masuk sekolah", "ch": "我们刚开学。", "cp": "Wǒmen gāng kāi xué.", "ca": "Kami baru mulai semester."}, {"h": "开", "p": "kāi", "a": "membuka / memulai", "ch": "请开门。", "cp": "Qǐng kāi mén.", "ca": "Tolong buka pintunya."}, {"h": "有(一)点儿", "p": "yǒu(yì)diǎnr", "a": "agak / sedikit (hal kurang menyenangkan)", "ch": "我有点儿累。", "cp": "Wǒ yǒudiǎnr lèi.", "ca": "Saya agak lelah."}, {"h": "点儿", "p": "diǎnr", "a": "sedikit", "ch": "快点儿！", "cp": "Kuài diǎnr!", "ca": "Cepat sedikit!"}, {"h": "还是", "p": "háishi", "a": "atau (dalam pertanyaan)", "ch": "你喝茶还是咖啡？", "cp": "Nǐ hē chá háishi kāfēi?", "ca": "Kamu minum teh atau kopi?"}, {"h": "咖啡", "p": "kāfēi", "a": "kopi", "ch": "我喝咖啡。", "cp": "Wǒ hē kāfēi.", "ca": "Saya minum kopi."}, {"h": "杯", "p": "bēi", "a": "cangkir / gelas", "ch": "一杯茶。", "cp": "Yì bēi chá.", "ca": "Satu cangkir teh."}, {"h": "车", "p": "chē", "a": "kendaraan", "ch": "你的车是新的还是旧的？", "cp": "Nǐ de chē shì xīn de háishi jiù de?", "ca": "Kendaraanmu baru atau lama?"}, {"h": "自行车", "p": "zìxíngchē", "a": "sepeda", "ch": "我骑自行车。", "cp": "Wǒ qí zìxíngchē.", "ca": "Saya naik sepeda."}, {"h": "汽车", "p": "qìchē", "a": "mobil / bus", "ch": "他开汽车。", "cp": 