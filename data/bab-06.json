[{"h": "请问", "p": "qǐngwèn", "a": "permisi, mau tanya", "ch": "请问，你叫什么名字？", "cp": "Qǐngwèn, nǐ jiào shénme míngzi?", "ca": "Permisi, siapa namamu?"}, {"h": "问", "p": "wèn", "a": "bertanya", "ch": "我问老师。", "cp": "Wǒ wèn lǎoshī.", "ca": "Saya bertanya kepada guru."}, {"h": "贵姓", "p": "guìxìng", "a": "marga Anda (sopan)", "ch": "您贵姓？", "cp": "Nín guìxìng?", "ca": "Siapa marga Anda?"}, {"h": "姓", "p": "xìng", "a": "bermarga / marga", "ch": "我姓王。", "cp": "Wǒ xìng Wáng.", "ca": "Marga saya Wang."}, {"h": "叫", "p": "jiào", "a": "bernama / memanggil", "ch": "我叫小明。", "cp": "Wǒ jiào Xiǎomíng.", "ca": "Nama saya Xiaoming."}, {"h": "名字", "p": "míngzi", "a": "nama", "ch": "你叫什么名字？", "cp": "Nǐ jiào shénme míngzi?", "ca": "Siapa namamu?"}, {"h": "哪", "p": "nǎ", "a": "yang mana", "ch": "你是哪国人？", "cp": "Nǐ shì nǎ guó rén?", "ca": "Kamu orang negara mana?"}, {"h": "国", "p": "guó", "a": "negara", "ch": "中国很大。", "cp": "Zhōngguó hěn dà.", "ca": "China sangat besar."}, {"h": "中国", "p": "Zhōngguó", "a": "China / Tiongkok", "ch": "我去中国。", "cp": "Wǒ qù Zhōngguó.", "ca": "Saya pergi ke China."}, {"h": "德国", "p": "Déguó", "a": "Jerman", "ch": "他是德国人。", "cp": "Tā shì Déguórén.", "ca": "Dia orang Jerman."}, {"h": "俄国", "p": "Éguó", "a": "Rusia", "ch": "她是俄国人。", "cp": "Tā shì Éguórén.", "ca": "Dia orang Rusia."}, {"h": "法国", "p": "Fǎguó", "a": "Prancis", "ch": "我朋友是法国人。", "cp": "Wǒ péngyou shì Fǎguórén.", "ca": "Teman saya orang Prancis."}, {"h": "韩国", "p": "Hánguó", "a": "Korea (Selatan)", "ch": "他是韩国人。", "cp": "Tā shì Hánguórén.", "ca": "Dia orang Korea."}, {"h": "美国", "p": "Měiguó", "a": "Amerika Serikat", "ch": "你是美国人吗？", "cp": "Nǐ shì Měiguórén ma?", "ca": "Apakah kamu orang Amerika?"}, {"h": "日本(国)", "p": "Rìběn(guó)", "a": "Jepang", "ch": "她是日本人。", "cp": "Tā shì Rìběnrén.", "ca": "Dia orang Jepang."}, {"h": "英国", "p": "Yīngguó", "a": "Inggris (Britania)", "ch": "他不是英国人。", "cp": "Tā bú shì Yīngguórén.", "ca": "Dia bukan orang Inggris."}, {"h": "人", "p": "rén", "a": "orang", "ch": "他是中国人。", "cp": "Tā shì Zhōngguórén.", "ca": "Dia orang China."}, {"h": "学习", "p": "xuéxí", "a": "belajar", "ch": "我学习汉语。", "cp": "Wǒ xuéxí Hànyǔ.", "ca": "Saya belajar Mandarin."}, {"h": "汉字", "p": "Hànzì", "a": "aksara Han (karakter Mandarin)", "ch": "我写汉字。", "cp": "Wǒ xiě Hànzì.", "ca": "Saya menulis aksara Han."}, {"h": "发音", "p": "fāyīn", "a": "pelafalan / melafalkan", "ch": "你的发音很好。", "cp": "Nǐ de fāyīn hěn hǎo.", "ca": "Pelafalanmu bagus."}, {"h": "什么", "p": "shénme", "a": "apa", "ch": "这是什么？", "cp": "Zhè shì shénme?", "ca": "Apa ini?"}, {"h": "书", "p": "shū", "a": "buku", "ch": "这是汉语书。", "cp": "Zhè shì Hànyǔ shū.", "ca": "Ini buku Mandarin."}, {"h": "谁", "p": "shéi / shuí", "a": "siapa", "ch": "他是谁？", "cp": "Tā shì shéi?", "ca": "Dia siapa?"}, {"h": "的", "p": "de", "a": "partikel kepemilikan (punya)", "ch": "我的书。", "cp": "Wǒ de shū.", "ca": "Buku saya."}, {"h": "那", "p": "nà", "a": "itu", "ch": "那是杂志。", "cp": "Nà shì zázhì.", "ca": "Itu majalah."}, {"h": "杂志", "p": "zázhì", "a": "majalah", "ch": "那是谁的杂志？", "cp": "Nà shì shéi de zázhì?", "ca": "Itu majalah siapa?"}, {"h": "中文", "p": "Zhōngwén", "a": "bahasa Tionghoa (Mandarin)", "ch": "这是中文书。", "cp": "Zhè shì Zhōngwén shū.", "ca": "Ini buku berbahasa Mandarin."}, {"h": "阿拉伯文", "p": "Ālābówén", "a": "bahasa / tulisan Arab", "ch": "这是阿拉伯文杂志。", "cp": "Zhè shì Ālābówén zázhì.", "ca": "Ini majalah berbahasa Arab."}, {"h": "德文", "p": "Déwén", "a": "bahasa Jerman (tulisan)", "ch": "那是德文书。", "cp": "Nà shì Déwén shū.", "ca": "Itu buku berbahasa Jerman."}, {"h": "俄文", "p": "Éwén", "a": "bahasa Rusia (tulisan)", "ch": "这是俄文书。", "cp": "Zhè shì Éwén shū.", "ca": "Ini buku berbahasa Rusia."}, {"h": "法文", "p": "Fǎwén", "a": "bahasa Prancis (tulisan)", "ch": "那是法文杂志。", "cp": "Nà shì Fǎwén zázhì.", "ca": "Itu majalah berbahasa Prancis."}, {"h": "韩文", "p": "Hánwén", "a": "bahasa Korea (tulisan)", "ch": "他学习韩文。", "cp": "Tā xuéxí Hánwén.", "ca": "Dia belajar bahasa Korea."}, {"h": "日文", "p": "Rìwén", "a": "bahasa Jepang (tulisan)", "ch": "这是日文书吗？", "cp": "Zhè shì Rìwén shū ma?", "ca": "Apakah ini buku berbahasa Jepang?"}, {"h": "西班牙文", "p": "Xībānyáwén", "a": "bahasa Spanyol (tulisan)", "ch": "那是西班牙文杂志。", "cp": "Nà shì Xībānyáwén zázhì.", "ca": "Itu majalah berbahasa Spanyol."}, {"h": "英文", "p": "Yīngwén", "a": "bahasa Inggris (tulisan)", "ch": "那是英文杂志。", "cp": "Nà shì Yīngwén zázhì.", "ca": "Itu majalah berbahasa Inggris."}, {"h": "朋友", "p": "péngyou", "a": "teman", "ch": "他是我朋友。", "cp": "Tā shì wǒ péngyou.", "ca": "Dia teman saya."}]