[{"h": "年", "p": "nián", "a": "tahun", "ch": "你哪年毕业？", "cp": "Nǐ nǎ nián bì yè?", "ca": "Kamu lulus tahun berapa?"}, {"h": "今年", "p": "jīnnián", "a": "tahun ini", "ch": "你今年多大？", "cp": "Nǐ jīnnián duō dà?", "ca": "Tahun ini kamu umur berapa?"}, {"h": "明年", "p": "míngnián", "a": "tahun depan", "ch": "我明年毕业。", "cp": "Wǒ míngnián bì yè.", "ca": "Saya lulus tahun depan."}, {"h": "后年", "p": "hòunián", "a": "dua tahun lagi", "ch": "他后年去中国。", "cp": "Tā hòunián qù Zhōngguó.", "ca": "Dua tahun lagi dia pergi ke China."}, {"h": "去年", "p": "qùnián", "a": "tahun lalu", "ch": "去年我在北京学习。", "cp": "Qùnián wǒ zài Běijīng xuéxí.", "ca": "Tahun lalu saya belajar di Beijing."}, {"h": "毕业", "p": "bì yè", "a": "lulus / tamat", "ch": "你哪一年大学毕业？", "cp": "Nǐ nǎ yì nián dàxué bì yè?", "ca": "Tahun berapa kamu lulus kuliah?"}, {"h": "多", "p": "duō", "a": "seberapa (dalam pertanyaan)", "ch": "你的箱子多重？", "cp": "Nǐ de xiāngzi duō zhòng?", "ca": "Kopermu seberapa berat?"}, {"h": "多大", "p": "duō dà", "a": "berapa umur / seberapa besar", "ch": "你今年多大？", "cp": "Nǐ jīnnián duō dà?", "ca": "Tahun ini kamu umur berapa?"}, {"h": "岁", "p": "suì", "a": "tahun (umur)", "ch": "我今年二十岁。", "cp": "Wǒ jīnnián èrshí suì.", "ca": "Tahun ini saya berumur dua puluh tahun."}, {"h": "属", "p": "shǔ", "a": "bershio", "ch": "我属狗。", "cp": "Wǒ shǔ gǒu.", "ca": "Shio saya anjing."}, {"h": "狗", "p": "gǒu", "a": "anjing", "ch": "他属狗，我也属狗。", "cp": "Tā shǔ gǒu, wǒ yě shǔ gǒu.", "ca": "Shionya anjing, shio saya juga anjing."}, {"h": "月", "p": "yuè", "a": "bulan", "ch": "今天几月几号？", "cp": "Jīntiān jǐ yuè jǐ hào?", "ca": "Hari ini tanggal berapa bulan apa?"}, {"h": "号", "p": "hào", "a": "tanggal", "ch": "今天十月八号。", "cp": "Jīntiān shí yuè bā hào.", "ca": "Hari ini tanggal 8 Oktober."}, {"h": "生日", "p": "shēngri", "a": "ulang tahun", "ch": "你的生日是几月几号？", "cp": "Nǐ de shēngri shì jǐ yuè jǐ hào?", "ca": "Ulang tahunmu tanggal berapa?"}, {"h": "正好", "p": "zhènghǎo", "a": "kebetulan / pas", "ch": "今天正好是我的生日。", "cp": "Jīntiān zhènghǎo shì wǒ de shēngri.", "ca": "Kebetulan hari ini ulang tahun saya."}, {"h": "打算", "p": "dǎsuan", "a": "berencana / rencana", "ch": "你打算怎么过生日？", "cp": "Nǐ dǎsuan zěnme guò shēngri?", "ca": "Kamu berencana merayakan ulang tahun bagaimana?"}, {"h": "过", "p": "guò", "a": "merayakan / melewatkan (waktu)", "ch": "我打算在宿舍过生日。", "cp": "Wǒ dǎsuan zài sùshè guò shēngri.", "ca": "Saya berencana merayakan ulang tahun di asrama."}, {"h": "准备", "p": "zhǔnbèi", "a": "mempersiapkan / berencana", "ch": "我准备举行一个生日晚会。", "cp": "Wǒ zhǔnbèi jǔxíng yí gè shēngri wǎnhuì.", "ca": "Saya berencana mengadakan pesta ulang tahun."}, {"h": "举行", "p": "jǔxíng", "a": "mengadakan / menyelenggarakan", "ch": "晚会在我的房间举行。", "cp": "Wǎnhuì zài wǒ de fángjiān jǔxíng.", "ca": "Pestanya diadakan di kamar saya."}, {"h": "晚会", "p": "wǎnhuì", "a": "pesta malam / acara malam", "ch": "你来参加我的生日晚会吧。", "cp": "Nǐ lái cānjiā wǒ de shēngri wǎnhuì ba.", "ca": "Datanglah ke pesta ulang tahun saya."}, {"h": "参加", "p": "cānjiā", "a": "ikut / menghadiri", "ch": "我一定参加。", "cp": "Wǒ yídìng cānjiā.", "ca": "Saya pasti datang."}, {"h": "时间", "p": "shíjiān", "a": "waktu", "ch": "你有时间吗？", "cp": "Nǐ yǒu shíjiān ma?", "ca": "Kamu ada waktu?"}, {"h": "点(钟)", "p": "diǎn(zhōng)", "a": "jam / pukul", "ch": "现在几点？", "cp": "Xiànzài jǐ diǎn?", "ca": "Sekarang jam berapa?"}, {"h": "就", "p": "jiù", "a": "justru / tepat (penegas)", "ch": "就在我的房间。", "cp": "Jiù zài wǒ de fángjiān.", "ca": "Tepat di kamar saya."}, {"h": "一定", "p": "yídìng", "a": "pasti", "ch": "我一定去。", "cp": "Wǒ yídìng qù.", "ca": "Saya pasti pergi."}, {"h": "祝", "p": "zhù", "a": "mendoakan / mengucapkan selamat", "ch": "祝你们旅行愉快！", "cp": "Zhù nǐmen lǚxíng yúkuài!", "ca": "Selamat berlibur, semoga menyenangkan!"}, {"h": "快乐", "p": "kuàilè", "a": "gembira / bahagia", "ch": "我们都很快乐。", "cp": "Wǒmen dōu hěn kuàilè.", "ca": "Kami semua bahagia."}, {"h": "祝你生日快乐", "p": "zhù nǐ shēngri kuàilè", "a": "selamat ulang tahun", "ch": "祝你生日快乐！", "cp": "Zhù nǐ shēngri kuàilè!", "ca": "Selamat ulang tahun!"}]