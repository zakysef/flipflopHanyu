[{"h": "语言", "p": "yǔyán", "a": "bahasa", "ch": "我喜欢学习语言。", "cp": "Wǒ xǐhuan xuéxí yǔyán.", "ca": "Saya suka belajar bahasa."}, {"h": "大学", "p": "dàxué", "a": "universitas", "ch": "我在大学学习。", "cp": "Wǒ zài dàxué xuéxí.", "ca": "Saya belajar di universitas."}, {"h": "怎么样", "p": "zěnmeyàng", "a": "bagaimana", "ch": "你们大学怎么样？", "cp": "Nǐmen dàxué zěnmeyàng?", "ca": "Bagaimana universitas kalian?"}, {"h": "觉得", "p": "juéde", "a": "merasa / berpendapat", "ch": "我觉得很好。", "cp": "Wǒ juéde hěn hǎo.", "ca": "Menurut saya bagus."}, {"h": "语法", "p": "yǔfǎ", "a": "tata bahasa", "ch": "汉语语法不难。", "cp": "Hànyǔ yǔfǎ bù nán.", "ca": "Tata bahasa Mandarin tidak sulit."}, {"h": "听", "p": "tīng", "a": "mendengar", "ch": "我听音乐。", "cp": "Wǒ tīng yīnyuè.", "ca": "Saya mendengar musik."}, {"h": "和", "p": "hé", "a": "dan", "ch": "听和说不太难。", "cp": "Tīng hé shuō bú tài nán.", "ca": "Menyimak dan berbicara tidak terlalu sulit."}, {"h": "比较", "p": "bǐjiào", "a": "cukup / relatif; membandingkan", "ch": "汉语比较难。", "cp": "Hànyǔ bǐjiào nán.", "ca": "Bahasa Mandarin cukup sulit."}, {"h": "容易", "p": "róngyì", "a": "mudah", "ch": "这个很容易。", "cp": "Zhège hěn róngyì.", "ca": "Ini sangat mudah."}, {"h": "读", "p": "dú", "a": "membaca", "ch": "我读汉语书。", "cp": "Wǒ dú Hànyǔ shū.", "ca": "Saya membaca buku Mandarin."}, {"h": "写", "p": "xiě", "a": "menulis", "ch": "我写汉字。", "cp": "Wǒ xiě Hànzì.", "ca": "Saya menulis aksara Han."}, {"h": "但是", "p": "dànshì", "a": "tetapi", "ch": "语法不难，但是读和写很难。", "cp": "Yǔfǎ bù nán, dànshì dú hé xiě hěn nán.", "ca": "Tata bahasanya tidak sulit, tetapi membaca dan menulis sulit."}, {"h": "给", "p": "gěi", "a": "untuk / kepada", "ch": "我给你们介绍一下儿。", "cp": "Wǒ gěi nǐmen jièshào yíxiàr.", "ca": "Saya perkenalkan kepada kalian."}, {"h": "新", "p": "xīn", "a": "baru", "ch": "这是我的新书。", "cp": "Zhè shì wǒ de xīn shū.", "ca": "Ini buku baru saya."}, {"h": "同学", "p": "tóngxué", "a": "teman sekelas", "ch": "他是我同学。", "cp": "Tā shì wǒ tóngxué.", "ca": "Dia teman sekelas saya."}, {"h": "同屋", "p": "tóngwū", "a": "teman sekamar", "ch": "我的同屋是中国人。", "cp": "Wǒ de tóngwū shì Zhōngguórén.", "ca": "Teman sekamar saya orang China."}, {"h": "班", "p": "bān", "a": "kelas (rombongan belajar)", "ch": "你在哪个班学习？", "cp": "Nǐ zài nǎ ge bān xuéxí?", "ca": "Kamu belajar di kelas mana?"}]