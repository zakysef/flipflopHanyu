[{"h": "忙", "p": "máng", "a": "sibuk", "ch": "他很忙。", "cp": "Tā hěn máng.", "ca": "Dia sibuk."}, {"h": "吗", "p": "ma", "a": "partikel tanya (apakah?)", "ch": "你忙吗？", "cp": "Nǐ máng ma?", "ca": "Apakah kamu sibuk?"}, {"h": "很", "p": "hěn", "a": "sangat", "ch": "我很好。", "cp": "Wǒ hěn hǎo.", "ca": "Saya sangat baik."}, {"h": "汉语", "p": "Hànyǔ", "a": "bahasa Mandarin", "ch": "我学汉语。", "cp": "Wǒ xué Hànyǔ.", "ca": "Saya belajar Mandarin."}, {"h": "难", "p": "nán", "a": "sulit", "ch": "汉语不太难。", "cp": "Hànyǔ bú tài nán.", "ca": "Bahasa Mandarin tidak terlalu sulit."}, {"h": "太", "p": "tài", "a": "terlalu", "ch": "太好了！", "cp": "Tài hǎo le!", "ca": "Bagus sekali!"}, {"h": "爸爸", "p": "bàba", "a": "ayah", "ch": "我爸爸很忙。", "cp": "Wǒ bàba hěn máng.", "ca": "Ayah saya sibuk."}, {"h": "妈妈", "p": "māma", "a": "ibu", "ch": "我妈妈很好。", "cp": "Wǒ māma hěn hǎo.", "ca": "Ibu saya baik."}, {"h": "他", "p": "tā", "a": "dia (laki-laki)", "ch": "他是老师。", "cp": "Tā shì lǎoshī.", "ca": "Dia guru."}, {"h": "她", "p": "tā", "a": "dia (perempuan)", "ch": "她是我妈妈。", "cp": "Tā shì wǒ māma.", "ca": "Dia ibu saya."}, {"h": "男", "p": "nán", "a": "laki-laki", "ch": "他是男的。", "cp": "Tā shì nán de.", "ca": "Dia laki-laki."}, {"h": "哥哥", "p": "gēge", "a": "kakak laki-laki", "ch": "我有一个哥哥。", "cp": "Wǒ yǒu yí gè gēge.", "ca": "Saya punya satu kakak laki-laki."}, {"h": "弟弟", "p": "dìdi", "a": "adik laki-laki", "ch": "我弟弟还小。", "cp": "Wǒ dìdi hái xiǎo.", "ca": "Adik laki-laki saya masih kecil."}, {"h": "妹妹", "p": "mèimei", "a": "adik perempuan", "ch": "我妹妹很漂亮。", "cp": "Wǒ mèimei hěn piàoliang.", "ca": "Adik perempuan saya cantik."}]