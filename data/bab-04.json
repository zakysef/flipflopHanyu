[{"h": "今天", "p": "jīntiān", "a": "hari ini", "ch": "今天星期一。", "cp": "Jīntiān xīngqīyī.", "ca": "Hari ini hari Senin."}, {"h": "天", "p": "tiān", "a": "hari", "ch": "我去三天。", "cp": "Wǒ qù sān tiān.", "ca": "Saya pergi tiga hari."}, {"h": "昨天", "p": "zuótiān", "a": "kemarin", "ch": "昨天星期天。", "cp": "Zuótiān xīngqītiān.", "ca": "Kemarin hari Minggu."}, {"h": "星期", "p": "xīngqī", "a": "minggu (pekan)", "ch": "今天星期几？", "cp": "Jīntiān xīngqī jǐ?", "ca": "Hari ini hari apa?"}, {"h": "星期一", "p": "xīngqīyī", "a": "hari Senin", "ch": "星期一我去银行。", "cp": "Xīngqīyī wǒ qù yínháng.", "ca": "Hari Senin saya ke bank."}, {"h": "星期二", "p": "xīngqī'èr", "a": "hari Selasa", "ch": "今天星期二。", "cp": "Jīntiān xīngqī'èr.", "ca": "Hari ini hari Selasa."}, {"h": "星期三", "p": "xīngqīsān", "a": "hari Rabu", "ch": "星期三我去邮局。", "cp": "Xīngqīsān wǒ qù yóujú.", "ca": "Hari Rabu saya ke kantor pos."}, {"h": "星期四", "p": "xīngqīsì", "a": "hari Kamis", "ch": "明天星期四。", "cp": "Míngtiān xīngqīsì.", "ca": "Besok hari Kamis."}, {"h": "星期五", "p": "xīngqīwǔ", "a": "hari Jumat", "ch": "星期五我回学校。", "cp": "Xīngqīwǔ wǒ huí xuéxiào.", "ca": "Hari Jumat saya kembali ke sekolah."}, {"h": "星期六", "p": "xīngqīliù", "a": "hari Sabtu", "ch": "星期六我不忙。", "cp": "Xīngqīliù wǒ bù máng.", "ca": "Hari Sabtu saya tidak sibuk."}, {"h": "星期天", "p": "xīngqītiān", "a": "hari Minggu", "ch": "星期天你去哪儿？", "cp": "Xīngqītiān nǐ qù nǎr?", "ca": "Hari Minggu kamu pergi ke mana?"}, {"h": "几", "p": "jǐ", "a": "berapa (jumlah kecil); beberapa", "ch": "今天星期几？", "cp": "Jīntiān xīngqī jǐ?", "ca": "Hari ini hari apa?"}, {"h": "二", "p": "èr", "a": "dua", "ch": "今天星期二。", "cp": "Jīntiān xīngqī'èr.", "ca": "Hari ini hari Selasa."}, {"h": "三", "p": "sān", "a": "tiga", "ch": "三个人。", "cp": "Sān gè rén.", "ca": "Tiga orang."}, {"h": "四", "p": "sì", "a": "empat", "ch": "四个学生。", "cp": "Sì gè xuésheng.", "ca": "Empat pelajar."}, {"h": "哪儿", "p": "nǎr", "a": "mana / di mana / ke mana", "ch": "你去哪儿？", "cp": "Nǐ qù nǎr?", "ca": "Kamu pergi ke mana?"}, {"h": "那儿", "p": "nàr", "a": "di sana / ke sana", "ch": "他在那儿。", "cp": "Tā zài nàr.", "ca": "Dia di sana."}, {"h": "我", "p": "wǒ", "a": "saya", "ch": "我是学生。", "cp": "Wǒ shì xuésheng.", "ca": "Saya pelajar."}, {"h": "回", "p": "huí", "a": "kembali / pulang", "ch": "我回家。", "cp": "Wǒ huí jiā.", "ca": "Saya pulang ke rumah."}, {"h": "学校", "p": "xuéxiào", "a": "sekolah", "ch": "我回学校。", "cp": "Wǒ huí xuéxiào.", "ca": "Saya kembali ke sekolah."}, {"h": "再见", "p": "zàijiàn", "a": "sampai jumpa", "ch": "再见，明天见！", "cp": "Zàijiàn, míngtiān jiàn!", "ca": "Sampai jumpa, besok bertemu lagi!"}, {"h": "对不起", "p": "duìbuqǐ", "a": "maaf", "ch": "对不起，我迟到了。", "cp": "Duìbuqǐ, wǒ chídào le.", "ca": "Maaf, saya terlambat."}, {"h": "没关系", "p": "méi guānxi", "a": "tidak apa-apa", "ch": "没关系，别担心。", "cp": "Méi guānxi, bié dānxīn.", "ca": "Tidak apa-apa, jangan khawatir."}]