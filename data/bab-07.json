[{"h": "中午", "p": "zhōngwǔ", "a": "tengah hari / siang", "ch": "中午你吃什么？", "cp": "Zhōngwǔ nǐ chī shénme?", "ca": "Siang ini kamu makan apa?"}, {"h": "吃", "p": "chī", "a": "makan", "ch": "我吃米饭。", "cp": "Wǒ chī mǐfàn.", "ca": "Saya makan nasi."}, {"h": "饭", "p": "fàn", "a": "makanan / nasi", "ch": "我去食堂吃饭。", "cp": "Wǒ qù shítáng chī fàn.", "ca": "Saya ke kantin untuk makan."}, {"h": "食堂", "p": "shítáng", "a": "kantin / ruang makan", "ch": "食堂的饭很好吃。", "cp": "Shítáng de fàn hěn hǎochī.", "ca": "Makanan kantin enak."}, {"h": "馒头", "p": "mántou", "a": "mantou (roti kukus tanpa isi)", "ch": "我吃一个馒头。", "cp": "Wǒ chī yí gè mántou.", "ca": "Saya makan satu mantou."}, {"h": "米饭", "p": "mǐfàn", "a": "nasi putih", "ch": "我要一碗米饭。", "cp": "Wǒ yào yì wǎn mǐfàn.", "ca": "Saya mau satu mangkuk nasi."}, {"h": "米", "p": "mǐ", "a": "beras", "ch": "这是米。", "cp": "Zhè shì mǐ.", "ca": "Ini beras."}, {"h": "要", "p": "yào", "a": "mau / ingin (+ benda)", "ch": "我要一碗汤。", "cp": "Wǒ yào yì wǎn tāng.", "ca": "Saya mau satu mangkuk sup."}, {"h": "个", "p": "gè", "a": "kata penggolong umum", "ch": "一个人。", "cp": "Yí gè rén.", "ca": "Satu orang."}, {"h": "碗", "p": "wǎn", "a": "mangkuk", "ch": "我要两碗米饭。", "cp": "Wǒ yào liǎng wǎn mǐfàn.", "ca": "Saya mau dua mangkuk nasi."}, {"h": "鸡蛋", "p": "jīdàn", "a": "telur ayam", "ch": "我吃一个鸡蛋。", "cp": "Wǒ chī yí gè jīdàn.", "ca": "Saya makan satu telur."}, {"h": "鸡", "p": "jī", "a": "ayam", "ch": "我不吃鸡。", "cp": "Wǒ bù chī jī.", "ca": "Saya tidak makan ayam."}, {"h": "蛋", "p": "dàn", "a": "telur", "ch": "我要两个蛋。", "cp": "Wǒ yào liǎng gè dàn.", "ca": "Saya mau dua butir telur."}, {"h": "汤", "p": "tāng", "a": "sup", "ch": "这个汤很好喝。", "cp": "Zhège tāng hěn hǎohē.", "ca": "Sup ini enak."}, {"h": "啤酒", "p": "píjiǔ", "a": "bir", "ch": "他喝啤酒。", "cp": "Tā hē píjiǔ.", "ca": "Dia minum bir."}, {"h": "酒", "p": "jiǔ", "a": "minuman beralkohol / arak", "ch": "我不喝酒。", "cp": "Wǒ bù hē jiǔ.", "ca": "Saya tidak minum minuman beralkohol."}, {"h": "这些", "p": "zhèxiē", "a": "ini semua / hal-hal ini", "ch": "这些是什么？", "cp": "Zhèxiē shì shénme?", "ca": "Ini semua apa?"}, {"h": "些", "p": "xiē", "a": "beberapa (penggolong)", "ch": "那些书。", "cp": "Nàxiē shū.", "ca": "Buku-buku itu."}, {"h": "一些", "p": "yìxiē", "a": "beberapa / sedikit", "ch": "我买一些水果。", "cp": "Wǒ mǎi yìxiē shuǐguǒ.", "ca": "Saya beli beberapa buah."}, {"h": "那些", "p": "nàxiē", "a": "itu semua / hal-hal itu", "ch": "那些是我的。", "cp": "Nàxiē shì wǒ de.", "ca": "Itu semua milik saya."}, {"h": "饺子", "p": "jiǎozi", "a": "jiaozi (pangsit)", "ch": "我喜欢吃饺子。", "cp": "Wǒ xǐhuan chī jiǎozi.", "ca": "Saya suka makan jiaozi."}, {"h": "包子", "p": "bāozi", "a": "bakpao", "ch": "我要两个包子。", "cp": "Wǒ yào liǎng gè bāozi.", "ca": "Saya mau dua bakpao."}, {"h": "面条", "p": "miàntiáo", "a": "mi", "ch": "我吃面条。", "cp": "Wǒ chī miàntiáo.", "ca": "Saya makan mi."}]